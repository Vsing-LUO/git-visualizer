<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GitVisualizer.App.Dialogs.CloneRepositoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="克隆远程仓库" Width="650" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" xmlns:dialogs="clr-namespace:GitVisualizer.App.Dialogs;assembly=GitVisualizer">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="克隆远程 Git 仓库" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" Text="填写仓库地址，并选择仓库的访问方式。" FontSize="12" Opacity="0.65" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="仓库地址" FontWeight="SemiBold" />
      <TextBox Name="RepositoryUrlBox" Margin="0,7,0,0" Padding="9,7" ToolTip="例如 https://github.com/user/repository.git" />
      <TextBlock Margin="0,5,0,0" Text="支持 HTTPS、SSH 和本地 Git 仓库地址。" FontSize="11" Opacity="0.58" />
    </StackPanel>
    <StackPanel Grid.Row="2">
      <TextBlock Text="访问方式" Margin="0,0,0,8" FontWeight="SemiBold" />
      <Border Margin="0,0,0,10" Padding="15,12" BorderBrush="#3A5B8CFF" BorderThickness="1" CornerRadius="8">
        <RadioButton Name="PublicRepositoryOption" GroupName="CloneAuthentication" IsChecked="True" Checked="AuthenticationOption_OnChecked">
          <StackPanel Margin="8,0,0,0">
            <TextBlock Text="公开仓库（无需令牌）" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Text="适用于任何人都能读取的公开仓库，也可用于已配置 SSH Agent 的 SSH 地址。" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
          </StackPanel>
        </RadioButton>
      </Border>
      <Border Padding="15,12" BorderBrush="#28000000" BorderThickness="1" CornerRadius="8">
        <RadioButton Name="TokenLoginOption" GroupName="CloneAuthentication" Checked="AuthenticationOption_OnChecked">
          <StackPanel Margin="8,0,0,0">
            <TextBlock Text="令牌登录（私有 HTTPS 仓库）" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Text="使用 GitHub 等平台提供的用户名和个人访问令牌读取私有仓库。" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
          </StackPanel>
        </RadioButton>
      </Border>
    </StackPanel>
    <Grid Name="TokenFieldsPanel" Row="3" Margin="0,16,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="105" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="用户名" VerticalAlignment="Center" />
      <TextBox Name="UserNameBox" Grid.Column="1" Margin="0,4" Padding="8,6" />
      <TextBlock Grid.Row="1" Text="访问令牌" VerticalAlignment="Center" />
      <Grid Row="1" Column="1" Margin="0,4">
        <PasswordBox Name="TokenBox" Padding="8,6" PasswordChanged="TokenBox_OnPasswordChanged" />
        <TextBox Name="VisibleTokenBox" Padding="8,6" Visibility="Collapsed" TextChanged="VisibleTokenBox_OnTextChanged" />
      </Grid>
      <CheckBox Name="ShowTokenBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,2" Content="显示访问令牌" Checked="ShowTokenBox_OnChecked" Unchecked="ShowTokenBox_OnUnchecked" />
      <CheckBox Name="RememberCredentialBox" Grid.Row="3" Grid.Column="1" Margin="0,7,0,2" Content="克隆成功后保存到 Windows 凭据管理器" IsChecked="True" />
      <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,5,0,0" Text="令牌不会写入仓库地址、操作日志或项目文件。" FontSize="11" Opacity="0.58" />
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" />
      <Button Content="下一步：选择位置" IsDefault="True" Click="Continue_OnClick" />
    </StackPanel>
  </Grid>
</Window>