<Window x:Class="GitVisualizer.App.Dialogs.RecoveryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="恢复中心" Width="760" Height="500"
        MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="恢复中心" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,0" Text="恢复时会先保护当前状态，再进入新的 recovered/... 分支；原分支不会被改写。" Opacity="0.65"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <ListBox x:Name="RecoveryList" ItemsSource="{Binding}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Operation}"/>
                                <TextBlock Margin="0,3,0,0" FontSize="11" Opacity="0.62">
                                    <Run Text="{Binding LocalCreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                    <Run Text="  ·  "/>
                                    <Run Text="{Binding HeadId}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.5" Text="{Binding Id}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="18,0,4,0"
                                       Text="{Binding Size, StringFormat={}{0:N0} 字节}" Opacity="0.6"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="当前仓库还没有可用的恢复点。" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Padding="18,5"/>
            <Button Content="恢复所选状态…" Padding="18,5" Click="Restore_OnClick"/>
        </DockPanel>
    </Grid>
</Window>
