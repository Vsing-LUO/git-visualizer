<Window x:Class="GitVisualizer.App.Dialogs.RebaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="变基" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="将当前分支变基" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" Text="这会重写当前分支尚未合并的提交编号；执行前会自动创建恢复点。" TextWrapping="Wrap" Opacity="0.65"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="上游分支" VerticalAlignment="Center"/>
            <ComboBox x:Name="UpstreamBox" Grid.Column="1" ItemsSource="{Binding}" IsEditable="True"/>
            <TextBlock Grid.Row="1" Text="高级：onto 分支" Margin="0,12,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="OntoBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding}" IsEditable="True" ToolTip="留空时与上游分支相同"/>
        </Grid>
        <CheckBox x:Name="ConfirmRiskBox" Grid.Row="2" Margin="0,18,0,0"
                  Content="我理解变基会重写当前分支的本地提交历史"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="开始变基" Margin="8,0,0,0" IsDefault="True" Padding="18,5" Click="Confirm_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
