<Window x:Class="GitVisualizer.App.Dialogs.ForcePushConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Force-with-lease 推送" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="带租约的强制推送" FontSize="20" FontWeight="SemiBold" Foreground="#FFE05D5D"/>
            <TextBlock Margin="0,7,0,0" Text="仅当服务器分支仍等于本地上次获取的状态时才会更新。程序不会在确认前自动获取；租约失败时必须手动获取并检查。" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" Background="#18F5A623" CornerRadius="6">
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="InstructionText"/>
            <TextBox x:Name="ConfirmationBox" Margin="0,7,0,0" TextChanged="Confirmation_OnTextChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="确认推送" Margin="8,0,0,0" Padding="18,5"
                    IsDefault="True" IsEnabled="False" Click="Confirm_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
