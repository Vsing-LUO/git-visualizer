<Window x:Class="GitVisualizer.App.Dialogs.PushMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="推送监视器"
        Width="700" Height="480" MinWidth="580" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Git 推送监视器"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Margin="0,7,0,0"
                           Text="{Binding TargetDescription}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TargetDescription}"/>
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding RemoteUrl}"
                           FontSize="11"
                           Opacity="0.58"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RemoteUrl}"/>
            </StackPanel>
            <Border x:Name="ResultBadge"
                    Grid.Column="1"
                    Padding="14,7"
                    CornerRadius="16"
                    Background="#1A5B8CFF"
                    VerticalAlignment="Top">
                <TextBlock x:Name="ResultText"
                           Text="推送中"
                           Foreground="#5B8CFF"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,20,0,14">
            <DockPanel Margin="0,0,0,7">
                <TextBlock x:Name="StageText"
                           Text="正在准备推送…"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="ProgressText"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Opacity="0.62"/>
            </DockPanel>
            <ProgressBar x:Name="TransferProgress"
                         Height="7"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="过程记录"
                   Margin="0,0,0,7"
                   FontWeight="SemiBold"/>

        <Border Grid.Row="3"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="5"
                Background="#0D1117">
            <ListBox x:Name="ProgressList"
                     ItemsSource="{Binding Entries}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E6EDF3"
                     FontFamily="Consolas"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="3,2">
                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                       Foreground="#7D8590"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="ElapsedText"
                       VerticalAlignment="Center"
                       Opacity="0.62"/>
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="关闭"
                    Width="88"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="Close_OnClick"/>
        </DockPanel>
    </Grid>
</Window>
