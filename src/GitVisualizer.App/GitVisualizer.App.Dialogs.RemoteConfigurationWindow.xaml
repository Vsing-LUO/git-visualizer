<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GitVisualizer.App.Dialogs.RemoteConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="配置远程仓库" Width="720" Height="390" MinWidth="620" MinHeight="340" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:dialogs="clr-namespace:GitVisualizer.App.Dialogs;assembly=GitVisualizer">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="22" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.ColumnSpan="3" Text="已配置的远程仓库" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
    <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="1" CornerRadius="5">
      <Grid>
        <ListBox Name="ConfiguredRemotesList" ItemsSource="{Binding ConfiguredRemotes}" SelectionChanged="ConfiguredRemotesList_OnSelectionChanged">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="6,5">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Margin="0,3,0,0" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Text="{Binding FetchUrl}" ToolTip="{Binding FetchUrl}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <TextBlock Name="NoRemotesHint" Text="尚未配置远程仓库" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" IsHitTestVisible="False" />
      </Grid>
    </Border>
    <Grid Row="1" Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="远程名称" />
      <TextBox Name="RemoteNameBox" Grid.Row="1" Margin="0,6,0,16" Padding="8,6" />
      <TextBlock Grid.Row="2" Text="仓库地址" />
      <StackPanel Grid.Row="3">
        <TextBox Name="RemoteUrlBox" Margin="0,6,0,8" Padding="8,6" />
        <TextBlock Text="支持 HTTPS 地址（如 https://github.com/user/repository.git）和 SSH 地址（如 git@github.com:user/repository.git）。" TextWrapping="Wrap" FontSize="11" Opacity="0.62" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
      <Button Content="新增远程" Click="NewRemote_OnClick" />
      <Button Name="DeleteRemoteButton" Content="删除远程" IsEnabled="False" ToolTip="删除当前选中的远程仓库配置" Click="DeleteRemote_OnClick" />
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" IsCancel="True" />
      <Button Content="保存" IsDefault="True" Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</Window>