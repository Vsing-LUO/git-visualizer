                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding LocationText}" />
                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Blocks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <controls:DiffBlockComparisonControl Block="{Binding}" OldLabel="{Binding DataContext.OldLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" NewLabel="{Binding DataContext.NewLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
