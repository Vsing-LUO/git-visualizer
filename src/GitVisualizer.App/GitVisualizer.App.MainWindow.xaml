      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragIncrement="2" KeyboardIncrement="16" Cursor="SizeWE" Background="{StaticResource SubtleBorderBrush}" ToolTip="左右拖动可调整详情区域宽度" />
      <Grid Name="FeaturePanelDock" Grid.Column="4">
        <Border Name="FeaturePanelDetachedPlaceholder" Margin="0" Padding="24" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
            <Border Width="54" Height="54" CornerRadius="27" Background="#261E6BFF" BorderBrush="#505B8CFF" BorderThickness="1">
              <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource AccentBrightBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,9 L3,3 L9,3 M15,3 L21,3 L21,9 M21,15 L21,21 L15,21 M9,21 L3,21 L3,15" />
            </Border>
            <TextBlock Margin="0,14,0,0" Text="功能区已在独立窗口打开" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
