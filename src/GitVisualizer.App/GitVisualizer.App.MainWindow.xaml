                  </Button>
                  <Button Style="{StaticResource CommitActionButton}" Foreground="{StaticResource DangerBrush}" ToolTip="将当前分支回退到所选提交" Click="Reset_OnClick">
                    <StackPanel>
                      <TextBlock Text="回退分支…" HorizontalAlignment="Center" />
                      <TextBlock Text="移动当前分支" FontSize="10" Opacity="0.65" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </UniformGrid>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="冲突">
          <ScrollViewer Name="ConflictZoomScope" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10" MinHeight="500">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Padding="12,9" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Padding="9,3" CornerRadius="10" Background="#185B8CFF" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding Conflicts.Count, StringFormat={}{0} 个待处理}" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="冲突解决器" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,12,0" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" Text="{Binding ConflictStatusText}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Margin="0,8,0,8" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                  <ListBox Name="ConflictList" BorderThickness="0" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict, Mode=OneWay}" SelectionChanged="ConflictList_OnSelectionChanged">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="2">
                          <Border Name="BinaryBadge" DockPanel.Dock="Right" Padding="6,2" CornerRadius="8" Background="#18E05D5D" Visibility="Collapsed">
                            <TextBlock Text="二进制" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                          </Border>
                          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Path}" ToolTip="{Binding Path}" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsBinary}">
                            <Setter TargetName="BinaryBadge" Property="UIElement.Visibility" Value="Visible" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="没有待处理的冲突文件" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" controls:PanelTextZoom.IsExcluded="True">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Value="0" Binding="{Binding Conflicts.Count}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </Grid>
              </Border>
              <Grid Row="2">
                <Grid IsEnabled="{Binding HasSelectedConflict}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="70" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="3*" MinHeight="90" />
                  </Grid.RowDefinitions>
                  <Border Padding="9,6" Background="{StaticResource PanelBrush}" CornerRadius="4">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" FontSize="10" Opacity="0.5" VerticalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="选择版本后仍可在下方手工编辑" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding SelectedConflict.IsBinary}">
                                <Setter Property="Text" Value="二进制文件：文本解决已安全锁定" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                      <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding SelectedConflict.Path, TargetNullValue=未选择文件}" ToolTip="{Binding SelectedConflict.Path}" />
                    </DockPanel>
                  </Border>
                  <Expander Grid.Row="1" Header="查看共同祖先版本（Base）" Margin="0,5,0,5" FontSize="11">
                    <TextBox MaxHeight="120" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Text="{Binding ConflictBaseText}" />
                  </Expander>
                  <Grid Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="34" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="9,0" Background="#125B8CFF" CornerRadius="4,4,0,0">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="8" Background="#205B8CFF" VerticalAlignment="Center">
                              <TextBlock Text="OURS" FontSize="9" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="当前版本" VerticalAlignment="Center" FontWeight="SemiBold" />
                          </DockPanel>
                        </Border>
                        <TextBox Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="11" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Text="{Binding ConflictOursText}" />
                      </Grid>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#00FFFFFF" />
                    <Border Grid.Column="2" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="34" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="9,0" Background="#12F5A623" CornerRadius="4,4,0,0">
                          <DockPanel>
                            <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="8" Background="#20F5A623" VerticalAlignment="Center">
                              <TextBlock Text="THEIRS" FontSize="9" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                            <TextBlock Text="对方版本" VerticalAlignment="Center" FontWeight="SemiBold" />
                          </DockPanel>
                        </Border>
                        <TextBox Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="11" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Text="{Binding ConflictTheirsText}" />
                      </Grid>
                    </Border>
                  </Grid>
                  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF" />
                  <Border Grid.Row="4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Border Padding="9,0" Background="#125B8CFF" CornerRadius="4,4,0,0">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="可编辑" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                          <TextBlock Text="合并结果" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                      <Grid Row="1" Margin="5,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="采用当前" Padding="5,3" MinHeight="28" IsEnabled="{Binding CanEditSelectedConflict}" Click="UseOurs_OnClick" />
                        <Button Grid.Column="1" Content="采用对方" Padding="5,3" MinHeight="28" IsEnabled="{Binding CanEditSelectedConflict}" Click="UseTheirs_OnClick" />
                        <Button Grid.Column="2" Content="合并两者" Padding="5,3" MinHeight="28" IsEnabled="{Binding CanEditSelectedConflict}" Click="UseBoth_OnClick" />
                      </Grid>
                      <TextBox Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="11" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ToolTip="确认内容正确后，在下方标记为已解决" Text="{Binding ConflictResultText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding SelectedConflict.IsBinary}" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="10" Padding="24" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding SelectedConflict.IsBinary}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                      <TextBlock Text="二进制冲突安全解决器" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Margin="0,10,0,18" Text="程序会直接复制 Git 对象中的原始字节，不会把文件当作文本解码。也可以先用外部程序替换工作区文件，再采用当前工作区文件。" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65" />
                      <UniformGrid Columns="3">
                        <Button Content="采用当前版本 (ours)" Margin="3" Padding="10,8" Click="ResolveBinaryOurs_OnClick" />
                        <Button Content="采用对方版本 (theirs)" Margin="3" Padding="10,8" Click="ResolveBinaryTheirs_OnClick" />
                        <Button Content="使用当前工作区文件" Margin="3" Padding="10,8" Click="ResolveBinaryCurrentFile_OnClick" />
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Padding="24" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False" controls:PanelTextZoom.IsExcluded="True">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding HasSelectedConflict}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Grid>
                    <controls:SpaceBackdrop Opacity="0.48" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Grid Width="72" Height="72">
                        <Ellipse Fill="#192538" />
                        <TextBlock Text="" Style="{StaticResource IconGlyph}" FontSize="37" Foreground="#66758F" />
                        <Ellipse Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="✓" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" Foreground="#FFFFFFFF" />
                      </Grid>
                      <TextBlock Text="✓" HorizontalAlignment="Center" FontSize="28" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" controls:PanelTextZoom.IsExcluded="True" />
                      <TextBlock Text="没有需要编辑的冲突" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                      <TextBlock Text="出现冲突时，请先从上方选择一个文件。" Margin="0,4,0,0" TextAlignment="Center" FontSize="11" Opacity="0.55" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <Border Grid.Row="3" Margin="0,9,0,0" Padding="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="完成当前文件" FontWeight="SemiBold" />
                      <TextBlock Text="保存合并结果并加入暂存区" Margin="0,2,12,0" FontSize="10" Opacity="0.55" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="标记为已解决" Padding="13,5" Background="{StaticResource AccentBrush}" Foreground="#FFFFFFFF" BorderThickness="0" IsEnabled="{Binding CanEditSelectedConflict}" Click="ResolveConflict_OnClick" />
                  </Grid>
                  <Grid Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="继续 Git 操作" ToolTip="所有冲突解决后继续合并、变基或拣选操作" IsEnabled="{Binding CanContinueOperation}" Click="ContinueOperation_OnClick" />
                    <Button Grid.Column="1" Content="中止 Git 操作" Foreground="{StaticResource DangerBrush}" ToolTip="放弃当前操作并恢复到操作前状态" IsEnabled="{Binding CanAbortOperation}" Click="AbortOperation_OnClick" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource Tab.Log}">
          <Grid Name="LogZoomScope">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox Margin="7" ItemsSource="{Binding OperationLog}" SelectedItem="{Binding SelectedOperationLog, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,4,2,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="46" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                      <Rectangle Width="1" Fill="#46566E" VerticalAlignment="Stretch" />
                      <Ellipse Width="28" Height="28" Fill="#172A4A" Stroke="{StaticResource AccentBrightBrush}" StrokeThickness="1" />
                      <TextBlock Text="↑" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" controls:PanelTextZoom.IsExcluded="True" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                      <DockPanel>
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Summary}" />
                      </DockPanel>
                      <TextBlock Margin="0,5,0,0" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="#9CA3AF" Text="{Binding EquivalentCommand}" />
                      <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding DetailsText}" />
                      <Border Height="1" Margin="0,10,0,0" Background="{StaticResource SubtleBorderBrush}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Margin="10">
              <TextBlock Text="{DynamicResource Hint.EquivalentCommand}" FontSize="10" Opacity="0.55" />
              <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding EquivalentCommand}" />
            </StackPanel>
          </Grid>
        </TabItem>
          </TabControl>
          <Button Name="FeatureFullscreenButton" Width="36" Height="36" MinWidth="36" MinHeight="36" Margin="0,8,9,0" Padding="7" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#151E6BFF" BorderBrush="#425B8CFF" ToolTip="在独立最大化窗口中展开功能区" AutomationProperties.Name="在独立窗口展开功能区" Click="FeatureFullscreenButton_OnClick">
            <Grid Width="20" Height="20" IsHitTestVisible="False">
              <Path Name="FeatureExpandIcon" Stretch="Uniform" Stroke="{StaticResource AccentBrightBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,8 L2,2 L8,2 M12,2 L18,2 L18,8 M18,12 L18,18 L12,18 M8,18 L2,18 L2,12" />
              <Path Name="FeatureRestoreIcon" Stretch="Uniform" Stroke="{StaticResource AccentBrightBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Data="M7,2 L7,7 L2,7 M13,2 L13,7 L18,7 M18,13 L13,13 L13,18 M2,13 L7,13 L7,18" />
            </Grid>
          </Button>
          <Border Name="FeaturePanelToast" Margin="12,58,12,0" Padding="12,8" Panel.ZIndex="30" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="360" Background="#F01A2738" BorderBrush="#805B8CFF" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock Name="FeaturePanelToastText" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Background="{StaticResource SubtleBorderBrush}" ToolTip="上下拖动可调整暂存功能区高度" />
    <Border Grid.Row="4" Margin="8,4,8,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="46" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource SectionHeaderBrush}" BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="0,0,0,1">
              <DockPanel Margin="8,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="丢弃所选…" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="恢复所选文件到暂存区版本；只有一个文件时无需先选择；未跟踪文件会被删除，操作前会创建恢复点" Click="DiscardChange_OnClick" />
                  <Button Content="暂存所选" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="暂存当前选中的文件；只有一个文件时无需先选择；若相关编辑器内容未保存，将先保存" Click="StageSelectedFiles_OnClick" />
                  <CheckBox Name="SelectAllUnstagedCheckBox" Width="18" Height="18" Margin="8,0,2,0" VerticalAlignment="Center" ToolTip="选择或取消选择全部未暂存文件" AutomationProperties.Name="选择全部未暂存文件" Click="SelectAllUnstaged_OnClick" />
                </StackPanel>
                <TextBlock Text="{DynamicResource Section.Unstaged}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Grid Row="1" ClipToBounds="True">
              <ListBox Name="UnstagedList" Margin="4,4,4,6" BorderThickness="0" ItemTemplate="{StaticResource ChangeTemplate}" SelectionMode="Extended" ToolTip="左键拖动框选多个文件；按住 Ctrl 可追加选择" AllowDrop="True" ItemsSource="{Binding UnstagedChanges}" SelectionChanged="ChangeList_OnSelectionChanged" PreviewMouseLeftButtonDown="ChangeList_OnPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ChangeList_OnPreviewMouseLeftButtonUp" PreviewMouseMove="ChangeList_OnPreviewMouseMove" Drop="UnstagedList_OnDrop">
                <FrameworkElement.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="丢弃所选文件的未暂存修改…" Click="DiscardChange_OnClick" />
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
              </ListBox>
              <Border Margin="14,8" Padding="12" CornerRadius="6" BorderBrush="#7A64748B" BorderThickness="1" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="BorderBrush" Value="#7A64748B" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding UnstagedChanges.Count}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Text="发生改动并保存的文件会显示在此处" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Canvas Name="UnstagedSelectionOverlay" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="UnstagedSelectionRectangle" Visibility="Collapsed" Fill="#285B8CFF" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
              </Canvas>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="46" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource SectionHeaderBrush}" BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="0,0,0,1">
              <DockPanel Margin="8,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="取消所选" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="取消暂存当前选中的文件；只有一个文件时无需先选择" Click="UnstageSelectedFiles_OnClick" />
                  <CheckBox Name="SelectAllStagedCheckBox" Width="18" Height="18" Margin="8,0,2,0" VerticalAlignment="Center" ToolTip="选择或取消选择全部已暂存文件" AutomationProperties.Name="选择全部已暂存文件" Click="SelectAllStaged_OnClick" />
                </StackPanel>
                <TextBlock Text="{DynamicResource Section.Staged}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Grid Row="1" ClipToBounds="True">
              <ListBox Name="StagedList" Margin="4,4,4,6" BorderThickness="0" ItemTemplate="{StaticResource ChangeTemplate}" SelectionMode="Extended" ToolTip="左键拖动框选多个文件；按住 Ctrl 可追加选择" AllowDrop="True" ItemsSource="{Binding StagedChanges}" SelectionChanged="ChangeList_OnSelectionChanged" PreviewMouseLeftButtonDown="ChangeList_OnPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ChangeList_OnPreviewMouseLeftButtonUp" PreviewMouseMove="ChangeList_OnPreviewMouseMove" Drop="StagedList_OnDrop" />
              <Border Margin="14,8" Padding="12" CornerRadius="6" BorderBrush="#7A64748B" BorderThickness="1" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding StagedChanges.Count}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Text="此处文件可提交或取消暂存" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Canvas Name="StagedSelectionOverlay" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="StagedSelectionRectangle" Visibility="Collapsed" Fill="#285B8CFF" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
              </Canvas>
            </Grid>
          </Grid>
        </Border>
        <Grid Name="CommitPanel" Column="2" SizeChanged="CommitPanel_OnSizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Name="CommitMessageRow" Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="{StaticResource SectionHeaderBrush}" BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,4">
              <TextBlock Name="CommitMessageHint" DockPanel.Dock="Right" Text="填写说明后提交" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
              <TextBlock Text="提交" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBox Name="CommitMessageTextBox" Grid.Row="1" Margin="10,8,10,4" AcceptsReturn="True" TextWrapping="Wrap" TextAlignment="Center" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" ToolTip="{DynamicResource Hint.CommitMessage}" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />
          <StackPanel Grid.Row="2" Margin="7,0,7,6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="修订最新提交" ToolTip="用当前提交说明和已暂存内容替换当前分支的最新提交" Command="{Binding AmendCommand}" />
            <Button Content="{DynamicResource Action.Commit}" Style="{StaticResource AccentButton}" Command="{Binding CommitCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <StatusBar Grid.Row="5" Margin="8,0" Padding="5,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock FontWeight="SemiBold" Text="{Binding CurrentBranch}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding UnstagedChanges.Count, StringFormat=◎  {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding StagedChanges.Count, StringFormat=◉  {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding ActiveRepositoryPath, StringFormat=仓库路径：  {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <ItemsControl ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Foreground="{StaticResource WarningBrush}" Margin="6,0" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StatusBarItem>
    </StatusBar>
    <Grid Name="CloneOverlay" RowSpan="6" ZIndex="1000" Background="#66000000" Visibility="{Binding IsCloning, Converter={StaticResource BoolToVisibility}}">
      <Border Width="560" MaxWidth="560" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="14">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.38" />
        </UIElement.Effect>
        <StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse Width="11" Height="11" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}">
              <FrameworkElement.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.45" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </FrameworkElement.Triggers>
            </Ellipse>
            <TextBlock Name="CloneTitleText" Text="正在克隆远程仓库" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Margin="0,12,0,18" Text="正在下载提交、分支和文件，请稍候…" FontSize="13" Opacity="0.68" HorizontalAlignment="Center" />
          <ProgressBar Name="CloneProgressBar" Height="9" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Margin="0,16,0,0" Text="克隆到" FontSize="11" Opacity="0.58" />
          <TextBlock Name="CloneDestinationText" Margin="0,5,0,0" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding CloneDestinationPath}" ToolTip="{Binding CloneDestinationPath}" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid Name="PullOverlay" RowSpan="6" ZIndex="1000" Background="#66000000" Visibility="{Binding IsPulling, Converter={StaticResource BoolToVisibility}}">
      <Border Width="560" MaxWidth="560" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="14">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.38" />
        </UIElement.Effect>
        <StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse Width="11" Height="11" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}">
              <FrameworkElement.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.45" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </FrameworkElement.Triggers>
            </Ellipse>
            <TextBlock Text="正在拉取远程更新" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Margin="0,12,0,18" Text="正在获取远程提交并更新当前分支，请稍候…" FontSize="13" Opacity="0.68" HorizontalAlignment="Center" />
          <ProgressBar Name="PullProgressBar" Height="9" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Margin="0,16,0,0" Text="更新方向" FontSize="11" Opacity="0.58" HorizontalAlignment="Center" />
          <TextBlock Name="PullSourceText" Margin="0,5,0,0" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding PullSourceText}" ToolTip="{Binding PullSourceText}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
