                            <StackPanel>
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontSize="10.5" Opacity="0.62" Text="{Binding StatusText}" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayPath}" />
                              </DockPanel>
                              <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap" Text="{Binding Summary}" />
                            </StackPanel>
                          </Border>
                        </HeaderedContentControl.Header>
                        <StackPanel>
                          <ItemsControl Margin="8,0" ItemsSource="{Binding Notices}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
