                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Value="True" Binding="{Binding HasDiffHunks}" />
                            <Condition Value="False" Binding="{Binding SelectedChange.IsStaged}" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
