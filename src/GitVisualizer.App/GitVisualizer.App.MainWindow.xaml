<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GitVisualizer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitVisualizer.App" xmlns:controls="clr-namespace:GitVisualizer.App.Controls" xmlns:converters="clr-namespace:GitVisualizer.App.Converters" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="{DynamicResource App.Title}" Icon="{StaticResource AppLogoImage}" Width="1624" Height="968" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" Drop="Window_OnDrop" DragOver="Window_OnDragOver">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <converters:BooleanToFontWeightConverter x:Key="BoolToFontWeightConverter" />
      <converters:RepositoryPathDisplayConverter x:Key="RepositoryPathDisplayConverter" />
      <DataTemplate x:Key="ChangeTemplate">
        <Grid ToolTip="{Binding Path}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentBrush}">
            <TextBlock FontSize="9" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding State}" />
          </Border>
          <TextBlock Grid.Column="1" Margin="6,0" TextTrimming="CharacterEllipsis" Text="{Binding Path}" />
          <TextBlock Grid.Column="2" FontSize="10" Opacity="0.55" Text="{Binding Size, StringFormat={}{0:N0} B}" />
        </Grid>
      </DataTemplate>
      <HierarchicalDataTemplate x:Key="FileTreeTemplate" ItemsSource="{Binding Children}">
        <Grid Margin="1,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="" FontSize="14" Style="{StaticResource IconGlyph}" Foreground="{StaticResource SecondaryTextBrush}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
        </Grid>
      </HierarchicalDataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
      <RowDefinition Height="6" />
      <RowDefinition Name="StagingPanelRow" Height="{x:Static local:MainWindow.DefaultStagingPanelGridLength}" MinHeight="94" MaxHeight="420" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.RowSpan="2" Margin="8,0,8,4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Stretch" Padding="0" Background="#00FFFFFF" BorderThickness="0">
          <MenuItem Style="{StaticResource TopMenuItem}">
            <HeaderedItemsControl.Header>
              <TextBlock Text="仓库" Foreground="{StaticResource PrimaryTextBrush}" />
            </HeaderedItemsControl.Header>
            <MenuItem Header="配置远程仓库…" IsEnabled="{Binding HasRepository}" Click="ConfigureRemote_OnClick" />
            <Separator />
            <MenuItem Header="标签管理…" IsEnabled="{Binding HasRepository}" Click="TagManagement_OnClick" />
            <MenuItem Header="临时现场（stash）…" IsEnabled="{Binding HasRepository}" Click="StashManagement_OnClick" />
            <Separator />
            <MenuItem Header="恢复中心…" IsEnabled="{Binding HasRepository}" Click="RecoveryCenter_OnClick" />
          </MenuItem>
          <MenuItem Style="{StaticResource TopMenuItem}">
            <HeaderedItemsControl.Header>
              <TextBlock Text="分支" Foreground="{StaticResource PrimaryTextBrush}" />
            </HeaderedItemsControl.Header>
            <MenuItem Header="重命名所选分支…" IsEnabled="{Binding HasRepository}" Click="RenameBranch_OnClick" />
            <Separator />
            <MenuItem Header="变基当前分支…" IsEnabled="{Binding HasRepository}" Click="Rebase_OnClick" />
          </MenuItem>
          <MenuItem Style="{StaticResource TopMenuItem}">
            <HeaderedItemsControl.Header>
              <TextBlock Text="历史" Foreground="{StaticResource PrimaryTextBrush}" />
            </HeaderedItemsControl.Header>
            <MenuItem Header="切换到所选提交…" IsEnabled="{Binding HasRepository}" Click="CheckoutCommit_OnClick" />
            <MenuItem Header="比较两个提交…" IsEnabled="{Binding HasRepository}" Click="CompareCommits_OnClick" />
          </MenuItem>
          <MenuItem Style="{StaticResource TopMenuItem}">
            <HeaderedItemsControl.Header>
              <TextBlock Text="远程" Foreground="{StaticResource PrimaryTextBrush}" />
            </HeaderedItemsControl.Header>
            <MenuItem Header="拉取所选远程…" IsEnabled="{Binding HasRepository}" Click="Pull_OnClick" />
            <MenuItem Header="使用 force-with-lease 推送…" IsEnabled="{Binding HasRepository}" Click="ForcePush_OnClick" />
          </MenuItem>
          <MenuItem Name="TerminalMenuItem" IsEnabled="{Binding HasRepository}" ToolTip="在当前仓库根目录打开终端" Click="OpenTerminal_OnClick">
            <MenuItem.Style>
              <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource TopMenuItem}">
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </MenuItem.Style>
            <HeaderedItemsControl.Header>
              <TextBlock Text="终端" Foreground="{StaticResource PrimaryTextBrush}" />
            </HeaderedItemsControl.Header>
          </MenuItem>
        </Menu>
        <DockPanel Grid.Row="1" Margin="10,1">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Open}" Click="OpenRepository_OnClick" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Init}" Click="InitializeRepository_OnClick" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Clone}" Click="CloneRepository_OnClick" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="配置远程仓库" ToolTip="添加远程仓库，或查看和更新已有远程配置" Click="ConfigureRemote_OnClick" />
            <Separator Margin="5,8" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Fetch}" Command="{Binding FetchCommand}" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Pull}" Click="Pull_OnClick" />
            <ComboBox Style="{StaticResource RemoteComboBoxStyle}" Margin="7,3,5,5" TextSearch.TextPath="Name" ToolTip="选择获取、拉取和推送使用的远程仓库" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinWidth="286" Margin="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="6" Background="#261E6BFF" VerticalAlignment="Center">
                      <TextBlock Text="" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource AccentBrightBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" FontSize="12.5" Text="{Binding Name}" />
                      <TextBlock Margin="0,2,0,0" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding FetchUrl}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="远程" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="{DynamicResource Action.Push}" ToolTip="推送到左侧选中的远程仓库，并打开推送监视窗口" Click="Push_OnClick" />
            <Separator Margin="5,8" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="身份" Click="Identity_OnClick" />
            <Button Style="{StaticResource ToolbarButton}" Tag="" Content="凭据" Click="Credential_OnClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <ProgressBar Width="100" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel Margin="18,0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding CurrentBranch}" />
            <TextBlock FontSize="10" Opacity="0.58" TextTrimming="CharacterEllipsis" Text="{Binding ActiveRepositoryPath}" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>
    <Grid Row="2" Margin="8,0" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="RepositoryColumn" Width="350" MinWidth="270" MaxWidth="430" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Name="DetailsColumn" Width="420" MinWidth="320" MaxWidth="720" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="{x:Static local:MainWindow.MinimumBranchListHeight}" />
            <RowDefinition Height="6" />
            <RowDefinition Name="FileWorkspaceRow" Height="{x:Static local:MainWindow.DefaultFileWorkspaceGridLength}" MinHeight="{x:Static local:MainWindow.MinimumFileWorkspaceHeight}" MaxHeight="{x:Static local:MainWindow.MaximumFileWorkspaceHeight}" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Text="{DynamicResource Section.Repositories}" />
            <Button DockPanel.Dock="Right" Content="打开目录" Height="25" MinHeight="25" Padding="8,2" Margin="0,6,8,4" ToolTip="在文件资源管理器中打开所选仓库" IsEnabled="{Binding HasRepository}" Click="OpenRepositoryFolder_OnClick" />
            <ComboBox DockPanel.Dock="Right" Width="112" Height="30" MinHeight="30" Margin="0,4,6,4" VerticalContentAlignment="Center" ToolTip="仓库排序方式" ItemsSource="{Binding RepositorySortModes}" SelectedItem="{Binding RepositorySortMode, Mode=TwoWay}" SelectionChanged="RepositorySort_OnSelectionChanged" />
          </DockPanel>
          <ListBox Name="RecentRepositoriesList" Grid.Row="1" ItemsSource="{Binding RecentRepositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}" SelectionChanged="RecentRepositories_OnSelectionChanged" PreviewMouseRightButtonDown="RecentRepositories_OnPreviewMouseRightButtonDown">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ShowDuration="60000" Text="{Binding Converter={StaticResource RepositoryPathDisplayConverter}}" ToolTip="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <FrameworkElement.ContextMenu>
              <ContextMenu>
                <MenuItem Header="从列表中移除" Click="RemoveRepository_OnClick" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </ListBox>
          <Grid Row="2" Margin="10,7,10,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="1" HorizontalAlignment="Stretch">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#003B82F6" Offset="0" />
                  <GradientStop Color="#8A3B82F6" Offset="0.16" />
                  <GradientStop Color="#4D8B5CF6" Offset="0.78" />
                  <GradientStop Color="#003B82F6" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid Row="1" Margin="2,8,2,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="24" Height="24" CornerRadius="6" Background="#241E6BFF">
                <TextBlock Text="⎇" FontSize="15" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1" Text="{DynamicResource Section.Branches}" Margin="7,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="2" Width="28" Height="24" MinWidth="28" MinHeight="24" Margin="0,0,7,0" Padding="0" Content="•••" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" ToolTip="更多分支操作" Click="BranchActionsMenu_OnClick">
                <FrameworkElement.ContextMenu>
                  <ContextMenu Placement="Bottom">
                    <MenuItem Header="合并到当前分支" Click="MergeBranch_OnClick" />
                    <MenuItem Header="重命名该分支…" Click="RenameBranch_OnClick" />
                    <Separator />
                    <MenuItem Header="删除该分支…" Click="DeleteBranch_OnClick" />
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
              </Button>
              <Border Grid.Column="3" Padding="7,2" CornerRadius="9" Background="#172334">
                <TextBlock FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Branches.Count, StringFormat={}{0} 个引用}" />
              </Border>
            </Grid>
          </Grid>
          <ListBox Name="BranchList" Grid.Row="3" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}" MouseDoubleClick="BranchList_OnMouseDoubleClick" PreviewMouseLeftButtonDown="BranchList_OnPreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="BranchList_OnPreviewMouseRightButtonDown">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="{x:Static local:MainWindow.BranchItemHeight}" Margin="4,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="⎇" FontSize="17" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="单击查看该分支指向的提交；双击切换分支" Text="{Binding FriendlyName}" FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeightConverter}, FallbackValue=Normal}" />
                  <Border Name="HeadBadge" Grid.Column="2" Width="40" Height="20" Margin="6,0,0,0" Padding="0" Background="#2B1E6BFF" CornerRadius="8" Visibility="Collapsed">
                    <TextBlock Text="HEAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                  </Border>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsCurrent}">
                    <Setter TargetName="HeadBadge" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <FrameworkElement.ContextMenu>
              <ContextMenu>
                <MenuItem Header="合并到当前分支" Click="MergeBranch_OnClick" />
                <MenuItem Header="重命名该分支…" Click="RenameBranch_OnClick" />
                <Separator />
                <MenuItem Header="删除该分支…" Click="DeleteBranch_OnClick" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </ListBox>
          <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragIncrement="2" KeyboardIncrement="12" Cursor="SizeNS" Background="{StaticResource SubtleBorderBrush}" ToolTip="上下拖动可调整文件工作区高度（180–280，默认 230）" />
          <Grid Row="5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Section.Files}" />
              <TextBlock Margin="4,0,6,0" VerticalAlignment="Center" FontSize="11" Opacity="0.65" Text="{Binding FileTreeContextText}" />
              <Button DockPanel.Dock="Right" Content="返回工作区" Height="27" MinHeight="27" Padding="8,2" Margin="0,6,8,4" Command="{Binding ShowWorkingTreeCommand}" Visibility="{Binding IsBrowsingHistoricalCommit, Converter={StaticResource BoolToVisibility}}" />
              <Button Name="NewItemButton" DockPanel.Dock="Right" Margin="0,6,8,5" ToolTip="在当前选中的目录中新建文件或文件夹" IsEnabled="{Binding CanModifyFileTree}" Click="NewItemMenu_OnClick">
                <ContentControl.Content>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="15" Margin="0,-1,6,0" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="新建文件" FontSize="11.5" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </ContentControl.Content>
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource NewFileButtonStyle}" TargetType="{x:Type Button}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBrowsingHistoricalCommit}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <FrameworkElement.ContextMenu>
                  <ContextMenu Placement="Bottom">
                    <MenuItem Header="📁  文件夹" Tag="folder" Click="NewItemType_OnClick" />
                    <Separator />
                    <MenuItem Header="📄  文本文档 (.txt)" Tag=".txt" Click="NewItemType_OnClick" />
                    <MenuItem Header="Ⓜ  Markdown 文档 (.md)" Tag=".md" Click="NewItemType_OnClick" />
                    <MenuItem Header="W  Word 文档 (.docx)" Tag=".docx" Click="NewItemType_OnClick" />
                    <MenuItem Header="C#  C# 源文件 (.cs)" Tag=".cs" Click="NewItemType_OnClick" />
                    <MenuItem Header="◆  JSON 文件 (.json)" Tag=".json" Click="NewItemType_OnClick" />
                    <MenuItem Header="&lt;/&gt;  XML 文件 (.xml)" Tag=".xml" Click="NewItemType_OnClick" />
                    <Separator />
                    <MenuItem Name="SystemNewTypesMenuItem" Header="电脑上的其他类型">
                      <MenuItem Header="正在读取系统新建类型…" IsEnabled="False" />
                    </MenuItem>
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
              </Button>
            </DockPanel>
            <TreeView Name="FileTreeView" Grid.Row="1" ItemTemplate="{StaticResource FileTreeTemplate}" ItemsSource="{Binding FileTree}" SelectedItemChanged="FileTree_OnSelectedItemChanged" MouseDoubleClick="FileTree_OnMouseDoubleClick">
              <FrameworkElement.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="新建文件" IsEnabled="{Binding CanModifyFileTree}" Click="NewFile_OnClick" />
                  <MenuItem Header="新建文件夹" IsEnabled="{Binding CanModifyFileTree}" Click="NewFolder_OnClick" />
                  <MenuItem Header="重命名" IsEnabled="{Binding CanModifyFileTree}" Click="RenameFile_OnClick" />
                  <Separator />
                  <MenuItem Header="删除…" IsEnabled="{Binding CanModifyFileTree}" Click="DeleteFile_OnClick" />
                </ContextMenu>
              </FrameworkElement.ContextMenu>
            </TreeView>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#00FFFFFF" />
      <Border Grid.Column="2" Style="{StaticResource CardBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="10,4">
            <TextBlock DockPanel.Dock="Right" Text="点击节点查看详情；右键区域执行历史操作" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Section.History}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Margin="8,0,0,0" Padding="10,0" Height="26" MinWidth="66" VerticalAlignment="Center" CornerRadius="10" Background="#261E6BFF">
                <TextBlock FontSize="10.5" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding HistoryContextText}" />
              </Border>
              <ToggleButton Width="30" Height="28" Margin="6,0,0,0" Padding="5" VerticalAlignment="Center" AutomationProperties.Name="切换关系图显示" IsChecked="{Binding IsCommitGraphCollapsed, Mode=TwoWay}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Background" Value="#00FFFFFF" />
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                    <Setter Property="FrameworkElement.ToolTip" Value="收起关系图" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border Name="ButtonChrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="ButtonChrome" Property="Border.Background" Value="#12000000" />
                              <Setter TargetName="ButtonChrome" Property="Border.BorderBrush" Value="#28000000" />
                            </Trigger>
                            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                              <Setter TargetName="ButtonChrome" Value="{StaticResource AccentBrush}" Property="Border.BorderBrush" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                              <Setter TargetName="ButtonChrome" Property="Border.Background" Value="#145B8CFF" />
                              <Setter TargetName="ButtonChrome" Property="Border.BorderBrush" Value="#405B8CFF" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="ToggleButton.IsChecked" Value="True">
                        <Setter Property="FrameworkElement.ToolTip" Value="展开关系图" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid Width="18" Height="16" IsHitTestVisible="False">
                  <Border BorderBrush="#FF4B5563" BorderThickness="1.4" CornerRadius="4" />
                  <Border Width="4" Height="10" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#704B5563" CornerRadius="1">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="UIElement.Opacity" Value="1" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                            <Setter Property="UIElement.Opacity" Value="0.25" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Border>
                  <Rectangle Width="1" Height="11" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FF4B5563" />
                </Grid>
              </ToggleButton>
            </StackPanel>
          </DockPanel>
          <Grid Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
              <StackPanel HorizontalAlignment="Stretch">
                <controls:CommitGraphControl x:Name="CommitGraph" CommitSelected="CommitGraph_OnCommitSelected" BranchSelected="CommitGraph_OnBranchSelected" Items="{Binding History}" Branches="{Binding Branches}" Tags="{Binding Tags}" Events="{Binding HistoryEvents}" Head="{Binding Head}" IsGraphCollapsed="{Binding IsCommitGraphCollapsed}" SelectedBranchName="{Binding SelectedHistoryBranchName}" SelectedCommit="{Binding SelectedCommit, Mode=OneWay}">
                  <FrameworkElement.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="创建 Tag…" Click="CreateTag_OnClick" />
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                </controls:CommitGraphControl>
                <Button Margin="16,8,16,14" Padding="16,6" Content="{DynamicResource Action.LoadMore}" HorizontalAlignment="Center" Command="{Binding LoadMoreHistoryCommand}" Visibility="{Binding HasMoreHistory, Converter={StaticResource BoolToVisibility}}" />
                <Grid Margin="16,10,16,16" Visibility="{Binding IsHistoryComplete, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Height="1" VerticalAlignment="Center" Background="{StaticResource SubtleBorderBrush}" />
                  <TextBlock Grid.Column="1" Margin="12,0" Text="{DynamicResource Status.HistoryComplete}" FontSize="10.5" Opacity="0.58" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{StaticResource SubtleBorderBrush}" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
