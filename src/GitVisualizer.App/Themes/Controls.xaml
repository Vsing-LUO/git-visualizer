<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#42B883"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E05D5D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#28000000"/>
    <SolidColorBrush x:Key="SectionDividerBrush" Color="#6676818C"/>
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#125B8CFF"/>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.72"/>
        <Setter Property="Margin" Value="8,12,8,6"/>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
