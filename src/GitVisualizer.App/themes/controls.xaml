<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AppBackgroundColor">#080D15</Color>
  <Color x:Key="SurfaceColor">#0D1623</Color>
  <Color x:Key="PanelColor">#111C2B</Color>
  <Color x:Key="PanelElevatedColor">#162336</Color>
  <Color x:Key="BorderColor">#26364B</Color>
  <Color x:Key="BorderStrongColor">#334155</Color>
  <Color x:Key="PrimaryTextColor">#F2F5FA</Color>
  <Color x:Key="SecondaryTextColor">#94A3B8</Color>
  <Color x:Key="AccentColor">#1E6BFF</Color>
  <Color x:Key="AccentBrightColor">#3B82F6</Color>
  <Color x:Key="PurpleColor">#8B5CF6</Color>
  <Color x:Key="SuccessColor">#22C55E</Color>
  <Color x:Key="WarningColor">#F59E0B</Color>
  <Color x:Key="DangerColor">#EF4444</Color>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="WindowChromeBrush" Color="#090F19" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="PanelElevatedBrush" Color="{StaticResource PanelElevatedColor}" />
  <SolidColorBrush x:Key="ButtonBrush" Color="#162233" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1C2C42" />
  <SolidColorBrush x:Key="ButtonPressedBrush" Color="#203552" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="SectionDividerBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="SectionHeaderBrush" Color="#B30D1726" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#293B82F6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#64748B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#090F19" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource PrimaryTextColor}" />
  <DrawingImage x:Key="AppLogoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#142238" Geometry="M0,0 L32,0 L32,32 L0,32" />
        <GeometryDrawing Brush="#2478FF" Geometry="M16,4 A9,9 0 1 1 15.99,4M13.5,15 L18.5,15 L18.5,27 L13.5,27 M11.5,25 L20.5,25 L20.5,29 L11.5,29" />
        <GeometryDrawing Brush="#0B1730" Geometry="M16,10 A3,3 0 1 1 15.99,10" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>
  <Style x:Key="CardBorder" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="7" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Chrome" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Border.Background" Value="{StaticResource ButtonHoverBrush}" />
              <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#52657E" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Border.Background" Value="{StaticResource ButtonPressedBrush}" />
              <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrightBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="#8FEF4444" />
  </Style>
  <Style x:Key="ToolbarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="2,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="ToolbarChrome" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{TemplateBinding FrameworkElement.Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Margin="0,0,8,0" Foreground="{TemplateBinding Control.Foreground}" VerticalAlignment="Center" />
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ToolbarChrome" Property="Border.Background" Value="{StaticResource ButtonHoverBrush}" />
              <Setter TargetName="ToolbarChrome" Property="Border.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ToolbarChrome" Property="Border.Background" Value="{StaticResource ButtonPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ToolbarChrome" Property="UIElement.Opacity" Value="0.36" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NewFileButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="108" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="108" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="#B3121C2A" />
    <Setter Property="BorderBrush" Value="#4F64748B" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style x:Key="IconGlyph" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#B30C1522" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource AccentBrightBrush}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="TextChrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
            <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="TextChrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrightBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="TextChrome" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="DropDownToggle" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="ComboChrome" BorderThickness="1" CornerRadius="6" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <Grid Margin="9,0,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="31" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                      <Border Grid.Column="1" Width="24" Height="24" CornerRadius="5" Margin="0,0,3,0" Background="#281E6BFF" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentBrightBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="ComboChrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" Margin="0,4,0,0" Padding="4" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}">
                <ScrollViewer MaxHeight="280">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="ComboItemChrome" Padding="{TemplateBinding Control.Padding}" Margin="2,1" Background="{TemplateBinding Control.Background}" BorderBrush="#00FFFFFF" BorderThickness="1" CornerRadius="5">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ComboItemChrome" Property="Border.Background" Value="#241E6BFF" />
              <Setter TargetName="ComboItemChrome" Property="Border.BorderBrush" Value="#4D3B82F6" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="ComboItemChrome" Property="Border.Background" Value="#332563EB" />
              <Setter TargetName="ComboItemChrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrightBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RemoteComboBoxStyle" TargetType="{x:Type ComboBox}">
    <Setter Property="Width" Value="300" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#B3121E30" />
    <Setter Property="BorderBrush" Value="#5B466083" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="RemoteDropDownToggle" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="RemoteComboChrome" BorderThickness="1" CornerRadius="7" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <Grid>
                      <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" FontSize="17" Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentBrightBrush}" />
                        <StackPanel Grid.Column="1" Margin="6,0,4,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                          <TextBlock Text="远程仓库" FontSize="9.5" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                          <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding SelectedItem.Name, TargetNullValue=请选择, FallbackValue=请选择, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="24" Height="24" CornerRadius="5" Margin="0,0,6,0" Background="#281E6BFF" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentBrightBrush}" />
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="RemoteComboChrome" Property="Border.Background" Value="#D1182940" />
                      <Setter TargetName="RemoteComboChrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter TargetName="RemoteComboChrome" Property="Border.BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=RemoteDropDownToggle}">
              <Border Width="360" Margin="0,5,0,0" Padding="7" Background="#FA162336" BorderBrush="#7A3B82F6" BorderThickness="1" CornerRadius="8">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                </UIElement.Effect>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Margin="8,4,8,7" Text="选择远程仓库" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                  <ScrollViewer Grid.Row="1" MaxHeight="300">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                  <Border Grid.Row="2" Margin="5,3,5,5" Padding="12,10" Background="#8F0D1726" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource SubtleBorderBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock Text="" FontSize="14" Margin="0,0,7,0" Style="{StaticResource IconGlyph}" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="未显示远程时，请先配置远程仓库" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="5,1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="ItemChrome" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="#00FFFFFF" BorderThickness="1" CornerRadius="5">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#151E6BFF" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#2A1E6BFF" />
              <Setter TargetName="ItemChrome" Property="Border.BorderBrush" Value="#4D3B82F6" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemChrome" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TreeView}" TargetType="{x:Type TreeView}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="{x:Type TreeViewItem}" TargetType="{x:Type TreeViewItem}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="Margin" Value="3,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Name="ItemChrome" Grid.ColumnSpan="2" MinHeight="30"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" />
            <Border Name="HoverFill" Grid.ColumnSpan="2" Margin="1"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="4" Opacity="0" />
            <Border Name="SelectionFill" Grid.ColumnSpan="2" Margin="1"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="4" Opacity="0" />
            <Border Name="SelectionOutline" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="5" Opacity="0" />
            <Border Name="SelectionRail" Grid.ColumnSpan="2" Width="3" Height="18"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{StaticResource AccentBrightBrush}"
                    CornerRadius="0,2,2,0" Opacity="0" />

            <ToggleButton Name="Expander" Grid.Column="0" Width="18" Height="26"
                          Focusable="False"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Grid Background="#00FFFFFF">
                    <Path Name="Arrow" Width="5" Height="9"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4.5 L 0 9"
                          Stroke="{StaticResource SecondaryTextBrush}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform>
                        <RotateTransform Angle="0" />
                      </Path.RenderTransform>
                    </Path>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="UIElement.RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              ContentSource="Header" RecognizesAccessKey="True" />
            <ItemsPresenter Name="ItemsHost" Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="18,1,0,0" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TreeViewItem.HasItems" Value="False">
              <Setter TargetName="Expander" Property="UIElement.Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="TreeViewItem.IsExpanded" Value="True">
              <Setter TargetName="ItemsHost" Property="UIElement.Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="HoverFill" Property="UIElement.Opacity" Value="0.10" />
            </Trigger>
            <Trigger Property="TreeViewItem.IsSelected" Value="True">
              <Setter TargetName="SelectionFill" Property="UIElement.Opacity" Value="0.22" />
              <Setter TargetName="SelectionOutline" Property="UIElement.Opacity" Value="0.55" />
              <Setter TargetName="SelectionRail" Property="UIElement.Opacity" Value="1" />
              <Setter Property="Control.FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="TreeViewItem.IsSelected" Value="True" />
                <Condition Property="UIElement.IsKeyboardFocusWithin" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="SelectionFill" Property="UIElement.Opacity" Value="0.32" />
              <Setter TargetName="SelectionOutline" Property="UIElement.Opacity" Value="1" />
            </MultiTrigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="7" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#C70C1522" BorderThickness="0,0,0,1" BorderBrush="{StaticResource SubtleBorderBrush}">
                <TabPanel IsItemsHost="True" Margin="8,0" />
              </Border>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FeatureTabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="7" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#C70C1522" BorderThickness="0,0,0,1" BorderBrush="{StaticResource SubtleBorderBrush}">
                <TabPanel IsItemsHost="True" Margin="8,0,52,0" />
              </Border>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid Height="51" Background="#00FFFFFF">
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="Underline" Height="3" Margin="9,0" VerticalAlignment="Bottom" CornerRadius="2,2,0,0" Background="#00FFFFFF" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Underline" Property="Border.Background" Value="{StaticResource AccentBrightBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Menu}" TargetType="{x:Type Menu}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource WindowChromeBrush}" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="TopMenuItem" TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Grid>
            <Border Name="TopHeader" Height="41" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}">
              <Grid>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                <Border Name="TopUnderline" Height="3" VerticalAlignment="Bottom" Background="#00FFFFFF" CornerRadius="2,2,0,0" />
              </Grid>
            </Border>
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding MenuItem.IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Margin="0,2,0,0" Padding="4" MinWidth="210" BorderThickness="1" CornerRadius="7" Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="TopHeader" Property="Border.Background" Value="{StaticResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="MenuItem.IsSubmenuOpen" Value="True">
              <Setter TargetName="TopHeader" Property="Border.Background" Value="#1A1E6BFF" />
              <Setter TargetName="TopUnderline" Property="Border.Background" Value="{StaticResource AccentBrightBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
    <Setter Property="Background" Value="{StaticResource SubtleBorderBrush}" />
    <Setter Property="UIElement.Opacity" Value="0.9" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Margin" Value="12,12,8,7" />
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
</ResourceDictionary>
