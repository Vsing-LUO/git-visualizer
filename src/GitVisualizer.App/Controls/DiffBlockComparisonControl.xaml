<UserControl x:Class="GitVisualizer.App.Controls.DiffBlockComparisonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GitVisualizer.App.Controls"
             MinWidth="540"
             SizeChanged="Control_OnSizeChanged">
    <Border Margin="0,0,0,7" Padding="8"
            Background="{DynamicResource PanelBrush}"
            CornerRadius="5">
        <StackPanel>
            <TextBlock Text="{Binding Block.Title, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,2,0,6"
                       Text="{Binding Block.Description, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}"
                       FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding OldLabel, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}"
                           FontSize="10.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding NewLabel, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}"
                           FontSize="10.5" FontWeight="SemiBold"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Block.Rows, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <Border Padding="6,4" CornerRadius="3"
                                    PreviewMouseWheel="OldPane_OnPreviewMouseWheel">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#14D84A4A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsContext}" Value="True">
                                                <Setter Property="Background" Value="#0E6B7280"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasOldLine}" Value="False">
                                                <Setter Property="Background" Value="#0E6B7280"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding OldLineLabel}" FontSize="9.5" Opacity="0.55"/>
                                    <Grid MinHeight="16" ClipToBounds="True">
                                        <TextBlock Text="{Binding OldDisplayText}"
                                                   FontFamily="Cascadia Mono,Consolas"
                                                   FontSize="11" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OldIsPlaceholder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{Binding OldTranslationX, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="{Binding OldDisplayText}"
                                                   FontFamily="Cascadia Mono,Consolas"
                                                   FontSize="11" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OldIsPlaceholder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding OldAnnotation}"
                                               FontSize="9.5" Foreground="#FFC47A00"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="6,4" CornerRadius="3"
                                    PreviewMouseWheel="NewPane_OnPreviewMouseWheel">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1428A745"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsContext}" Value="True">
                                                <Setter Property="Background" Value="#0E6B7280"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasNewLine}" Value="False">
                                                <Setter Property="Background" Value="#0E6B7280"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding NewLineLabel}" FontSize="9.5" Opacity="0.55"/>
                                    <Grid MinHeight="16" ClipToBounds="True">
                                        <TextBlock Text="{Binding NewDisplayText}"
                                                   FontFamily="Cascadia Mono,Consolas"
                                                   FontSize="11" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewIsPlaceholder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{Binding NewTranslationX, RelativeSource={RelativeSource AncestorType=controls:DiffBlockComparisonControl}}"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="{Binding NewDisplayText}"
                                                   FontFamily="Cascadia Mono,Consolas"
                                                   FontSize="11" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewIsPlaceholder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding NewAnnotation}"
                                               FontSize="9.5" Foreground="#FFC47A00"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <ScrollBar x:Name="OldHorizontalScrollBar"
                           Orientation="Horizontal"
                           Minimum="0" SmallChange="24" LargeChange="196"
                           ValueChanged="OldScrollBar_OnValueChanged"
                           AutomationProperties.Name="修改前内容横向滚动"/>
                <ScrollBar x:Name="NewHorizontalScrollBar" Grid.Column="2"
                           Orientation="Horizontal"
                           Minimum="0" SmallChange="24" LargeChange="196"
                           ValueChanged="NewScrollBar_OnValueChanged"
                           AutomationProperties.Name="修改后内容横向滚动"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
