<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GitVisualizer.App.Dialogs.ResetModeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择回退方式" Width="720" SizeToContent="Height" MaxHeight="840" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" xmlns:dialogs="clr-namespace:GitVisualizer.App.Dialogs;assembly=GitVisualizer">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14">
        <ToggleButton Name="DetailedExplanationToggle" DockPanel.Dock="Right" Content="显示详细解释" Padding="12,6" VerticalAlignment="Top" Checked="DetailedExplanationToggle_OnChanged" Unchecked="DetailedExplanationToggle_OnChanged" />
        <StackPanel>
          <TextBlock Text="选择如何回退当前分支" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Name="TargetText" Margin="0,6,12,0" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Margin="0,0,0,14" Padding="12,9" Background="#152D8CFF" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="所选版本之后的提交会从当前分支历史中移除。请选择如何处理其中的文件修改。" TextWrapping="Wrap" Foreground="#FF2578C8" />
          <TextBlock Name="GeneralDetailedText" Margin="0,6,0,0" Text="回退只移动当前分支，不会删除其他分支。程序会在执行前创建恢复点；操作日志中仍会显示对应的 Git 命令。" TextWrapping="Wrap" FontSize="12" Opacity="0.72" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2">
        <Border Margin="0,0,0,10" Padding="16,13" BorderBrush="#3A5B8CFF" BorderThickness="1" CornerRadius="8">
          <RadioButton Name="MixedOption" GroupName="ResetMode" VerticalContentAlignment="Top" Checked="ModeOption_OnChecked">
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="保留修改，并取消暂存（推荐）" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Margin="0,5,0,0" Text="提交历史会回退，文件修改仍然保留，方便逐项检查后重新提交。" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
              <TextBlock Name="MixedDetailedText" Margin="0,6,0,0" Text="当前分支移动到所选版本，暂存区也恢复到该版本；之后的修改保留在工作区，并显示在“未暂存”区域。对应 Git 的 mixed 模式。" TextWrapping="Wrap" FontSize="12" Opacity="0.68" Visibility="Collapsed" />
            </StackPanel>
          </RadioButton>
        </Border>
        <Border Margin="0,0,0,10" Padding="16,13" BorderBrush="#28000000" BorderThickness="1" CornerRadius="8">
          <RadioButton Name="SoftOption" GroupName="ResetMode" VerticalContentAlignment="Top" Checked="ModeOption_OnChecked">
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="保留修改，并保持暂存" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Margin="0,5,0,0" Text="提交历史会回退，文件修改保持已暂存，可以立即重新创建提交。" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
              <TextBlock Name="SoftDetailedText" Margin="0,6,0,0" Text="仅把当前分支移动到所选版本，不改变暂存区和工作区。适合修改提交说明，或把多个提交重新整理为一个提交。对应 Git 的 soft 模式。" TextWrapping="Wrap" FontSize="12" Opacity="0.68" Visibility="Collapsed" />
            </StackPanel>
          </RadioButton>
        </Border>
        <Border Padding="16,13" Background="#10E05D5D" BorderBrush="#70E05D5D" BorderThickness="1" CornerRadius="8">
          <RadioButton Name="HardOption" GroupName="ResetMode" VerticalContentAlignment="Top" Checked="ModeOption_OnChecked">
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="彻底回到此版本" FontSize="15" FontWeight="SemiBold" Foreground="#FFD64545" />
              <TextBlock Margin="0,5,0,0" Text="丢弃所选版本之后的提交，以及当前受 Git 管理的文件修改。" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
              <TextBlock Name="HardDetailedText" Margin="0,6,0,0" Text="当前分支、暂存区和受 Git 管理的文件都会恢复到所选版本。尚未被 Git 跟踪的新文件通常不会删除。对应 Git 的 hard 模式。" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Visibility="Collapsed" />
            </StackPanel>
          </RadioButton>
        </Border>
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,14,0,16">
        <Border Padding="12,9" Background="#12000000" CornerRadius="6">
          <TextBlock Name="ResultSummaryText" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <CheckBox Name="HardConfirmation" Margin="4,12,0,0" Content="我了解这会丢弃所选版本之后的提交和当前文件修改。" Foreground="#FFD64545" FontWeight="SemiBold" Visibility="Collapsed" Checked="HardConfirmation_OnChanged" Unchecked="HardConfirmation_OnChanged" />
      </StackPanel>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="不回退" IsCancel="True" />
        <Button Name="ConfirmButton" IsDefault="True" Click="Confirm_OnClick" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>