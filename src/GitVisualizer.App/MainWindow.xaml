<Window x:Class="GitVisualizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitVisualizer.App.Controls"
        xmlns:converters="clr-namespace:GitVisualizer.App.Converters"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{DynamicResource App.Title}"
        Width="1520" Height="940" MinWidth="1120" MinHeight="720"
        AllowDrop="True" Drop="Window_OnDrop" DragOver="Window_OnDragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BooleanToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <DataTemplate x:Key="ChangeTemplate">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding State}" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="6,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat={}{0:N0} B}"
                           FontSize="10" Opacity="0.55"/>
            </Grid>
        </DataTemplate>
        <HierarchicalDataTemplate x:Key="FileTreeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▸" Margin="0,0,5,0" Opacity="0.55"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,2">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Open}"
                            Click="OpenRepository_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Init}"
                            Click="InitializeRepository_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Clone}"
                            Click="CloneRepository_OnClick"/>
                    <Separator Margin="5,8"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Refresh}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Fetch}"
                            Command="{Binding FetchCommand}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Pull}"
                            Click="Pull_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Push}"
                            Command="{Binding PushCommand}"/>
                    <Separator Margin="5,8"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="身份" Click="Identity_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="凭据" Click="Credential_OnClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <CheckBox x:Name="AutoSaveCheckBox" Content="自动保存" Margin="8,0"
                              VerticalAlignment="Center" IsChecked="{Binding AutoSave}"
                              PreviewMouseLeftButtonDown="AutoSaveCheckBox_OnPreviewMouseLeftButtonDown"/>
                    <ProgressBar Width="100" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <StackPanel Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentBranch}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveRepositoryPath}" FontSize="10" Opacity="0.58"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" MinWidth="190"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="400" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Section.Repositories}"/>
                        <ComboBox DockPanel.Dock="Right" Width="100" Height="25" Margin="0,6,8,4"
                                  ItemsSource="{Binding RepositorySortModes}"
                                  SelectedItem="{Binding RepositorySortMode, Mode=TwoWay}"
                                  SelectionChanged="RepositorySort_OnSelectionChanged"
                                  ToolTip="仓库排序方式"/>
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding RecentRepositories}"
                             SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                             SelectionChanged="RecentRepositories_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}"
                                               ToolTipService.ShowDuration="60000"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}" Text="{DynamicResource Section.Branches}"/>
                    <ListBox x:Name="BranchList" Grid.Row="3" ItemsSource="{Binding Branches}"
                             MouseDoubleClick="BranchList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="9" Opacity="0.6"
                                               Text="{Binding AheadBy, StringFormat=↑{0}}"/>
                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeightConverter}, FallbackValue=Normal}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="切换到分支" Click="CheckoutBranch_OnClick"/>
                                <MenuItem Header="合并到当前分支" Click="MergeBranch_OnClick"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <DockPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Section.Files}"/>
                        <Button x:Name="NewItemButton" DockPanel.Dock="Right"
                                Content="＋ 新建文件" Height="27" MinHeight="27"
                                Padding="8,2" Margin="0,6,8,4"
                                Click="NewItemMenu_OnClick"
                                ToolTip="在当前选中的目录中新建文件或文件夹">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="📁  文件夹" Tag="folder"
                                              Click="NewItemType_OnClick"/>
                                    <Separator/>
                                    <MenuItem Header="📄  文本文档 (.txt)" Tag=".txt"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="Ⓜ  Markdown 文档 (.md)" Tag=".md"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="W  Word 文档 (.docx)" Tag=".docx"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="C#  C# 源文件 (.cs)" Tag=".cs"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="◆  JSON 文件 (.json)" Tag=".json"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="&lt;/&gt;  XML 文件 (.xml)" Tag=".xml"
                                              Click="NewItemType_OnClick"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>
                    <TreeView x:Name="FileTreeView" Grid.Row="5" ItemsSource="{Binding FileTree}"
                              ItemTemplate="{StaticResource FileTreeTemplate}"
                              SelectedItemChanged="FileTree_OnSelectedItemChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建文件" Click="NewFile_OnClick"/>
                                <MenuItem Header="新建文件夹" Click="NewFolder_OnClick"/>
                                <MenuItem Header="重命名" Click="RenameFile_OnClick"/>
                                <Separator/>
                                <MenuItem Header="删除…" Click="DeleteFile_OnClick"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="10,4">
                    <TextBlock Text="{DynamicResource Section.History}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="点击节点查看详情；右键区域执行历史操作"
                               FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <controls:CommitGraphControl Items="{Binding History}"
                                                 CommitSelected="CommitGraph_OnCommitSelected"/>
                </ScrollViewer>
                <Button Grid.Row="2" Content="{DynamicResource Action.LoadMore}"
                        Command="{Binding LoadMoreHistoryCommand}" HorizontalAlignment="Center"/>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

            <TabControl Grid.Column="4">
                <TabItem Header="{DynamicResource Tab.Diff}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding DiffText}" FontFamily="Cascadia Mono,Consolas"
                                 FontSize="12" IsReadOnly="True" AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="暂存所选代码块" Command="{Binding StageSelectedHunkCommand}"/>
                            <Button Content="取消暂存代码块" Command="{Binding UnstageSelectedHunkCommand}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Tab.Editor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="5">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Action.Save}"
                                    Command="{Binding SaveEditorCommand}"/>
                            <TextBlock Text="{Binding CurrentDocument.Path}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <avalon:TextEditor Grid.Row="1"
                                           controls:AvalonEditBinding.Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           FontFamily="Cascadia Mono,Consolas" FontSize="13"
                                           ShowLineNumbers="True" WordWrap="False"/>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Tab.Details}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding DetailsText}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                            <Button Content="从此提交创建分支" Click="CreateBranch_OnClick"/>
                            <Button Content="拣选此提交" Click="CherryPick_OnClick"/>
                            <Button Content="撤销此提交" Click="Revert_OnClick"/>
                            <Button Content="Reset 到此提交…" Click="Reset_OnClick"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="冲突">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding Conflicts}" DisplayMemberPath="Path"
                                 SelectionChanged="ConflictList_OnSelectionChanged"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="当前分支（Ours）">
                                <TextBox Text="{Binding ConflictOursText}" IsReadOnly="True"
                                         AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto"/>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="合并结果">
                                <TextBox Text="{Binding ConflictResultText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto"/>
                            </GroupBox>
                            <GroupBox Grid.Column="2" Header="对方分支（Theirs）">
                                <TextBox Text="{Binding ConflictTheirsText}" IsReadOnly="True"
                                         AcceptsReturn="True" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto"/>
                            </GroupBox>
                        </Grid>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                            <Button Content="使用当前版本" Click="UseOurs_OnClick"/>
                            <Button Content="使用对方版本" Click="UseTheirs_OnClick"/>
                            <Button Content="两者都保留" Click="UseBoth_OnClick"/>
                            <Button Content="标记为已解决" Click="ResolveConflict_OnClick"/>
                            <Separator Margin="6,4"/>
                            <Button Content="继续操作" Click="ContinueOperation_OnClick"/>
                            <Button Content="中止操作" Click="AbortOperation_OnClick"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Tab.Log}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding OperationLog}"
                                 SelectedItem="{Binding SelectedOperationLog, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                       Opacity="0.55" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding EquivalentCommand}" FontFamily="Consolas"
                                                   FontSize="10" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="8">
                            <TextBlock Text="{DynamicResource Hint.EquivalentCommand}" FontSize="10" Opacity="0.55"/>
                            <TextBox Text="{Binding EquivalentCommand}" IsReadOnly="True" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="8,3">
                        <Button DockPanel.Dock="Right" Content="全部暂存" Command="{Binding StageAllCommand}"/>
                        <TextBlock Text="{DynamicResource Section.Unstaged}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="UnstagedList" Grid.Row="1" ItemsSource="{Binding UnstagedChanges}"
                             ItemTemplate="{StaticResource ChangeTemplate}"
                             SelectionChanged="ChangeList_OnSelectionChanged"
                             PreviewMouseMove="ChangeList_OnPreviewMouseMove"
                             AllowDrop="True" Drop="UnstagedList_OnDrop"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="8,3">
                        <Button DockPanel.Dock="Right" Content="全部取消" Command="{Binding UnstageAllCommand}"/>
                        <TextBlock Text="{DynamicResource Section.Staged}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="StagedList" Grid.Row="1" ItemsSource="{Binding StagedChanges}"
                             ItemTemplate="{StaticResource ChangeTemplate}"
                             SelectionChanged="ChangeList_OnSelectionChanged"
                             PreviewMouseMove="ChangeList_OnPreviewMouseMove"
                             AllowDrop="True" Drop="StagedList_OnDrop"/>
                </Grid>
                <Grid Grid.Column="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="{DynamicResource Hint.CommitMessage}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="修改上一提交" Command="{Binding AmendCommand}"/>
                        <Button Content="{DynamicResource Action.Commit}" Command="{Binding CommitCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <ItemsControl ItemsSource="{Binding Notices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" Margin="6,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
