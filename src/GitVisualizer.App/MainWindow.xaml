<Window x:Class="GitVisualizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitVisualizer.App.Controls"
        xmlns:converters="clr-namespace:GitVisualizer.App.Converters"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{DynamicResource App.Title}"
        Width="1520" Height="940" MinWidth="1120" MinHeight="720"
        AllowDrop="True" Drop="Window_OnDrop" DragOver="Window_OnDragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BooleanToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <DataTemplate x:Key="ChangeTemplate">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding State}" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="6,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat={}{0:N0} B}"
                           FontSize="10" Opacity="0.55"/>
            </Grid>
        </DataTemplate>
        <HierarchicalDataTemplate x:Key="FileTreeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▸" Margin="0,0,5,0" Opacity="0.55"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="244" MinHeight="94" MaxHeight="244"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="仓库">
                <MenuItem Header="配置远程仓库…" Click="ConfigureRemote_OnClick" IsEnabled="{Binding HasRepository}"/>
                <Separator/>
                <MenuItem Header="标签管理…" Click="TagManagement_OnClick" IsEnabled="{Binding HasRepository}"/>
                <MenuItem Header="临时现场（stash）…" Click="StashManagement_OnClick" IsEnabled="{Binding HasRepository}"/>
                <Separator/>
                <MenuItem Header="恢复中心…" Click="RecoveryCenter_OnClick" IsEnabled="{Binding HasRepository}"/>
            </MenuItem>
            <MenuItem Header="分支">
                <MenuItem Header="重命名所选分支…" Click="RenameBranch_OnClick" IsEnabled="{Binding HasRepository}"/>
                <Separator/>
                <MenuItem Header="变基当前分支…" Click="Rebase_OnClick" IsEnabled="{Binding HasRepository}"/>
            </MenuItem>
            <MenuItem Header="历史">
                <MenuItem Header="切换到所选提交…" Click="CheckoutCommit_OnClick" IsEnabled="{Binding HasRepository}"/>
                <MenuItem Header="比较两个提交…" Click="CompareCommits_OnClick" IsEnabled="{Binding HasRepository}"/>
            </MenuItem>
            <MenuItem Header="远程">
                <MenuItem Header="拉取所选远程…" Click="Pull_OnClick" IsEnabled="{Binding HasRepository}"/>
                <MenuItem Header="使用 force-with-lease 推送…" Click="ForcePush_OnClick" IsEnabled="{Binding HasRepository}"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,2">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Open}"
                            Click="OpenRepository_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Init}"
                            Click="InitializeRepository_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Clone}"
                            Click="CloneRepository_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="配置远程仓库"
                            Click="ConfigureRemote_OnClick"
                            ToolTip="添加远程仓库，或查看和更新已有远程配置"/>
                    <Separator Margin="5,8"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Refresh}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Fetch}"
                            Command="{Binding FetchCommand}"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Pull}"
                            Click="Pull_OnClick"/>
                    <ComboBox Width="150"
                              Margin="5,7,2,7"
                              Padding="7,2"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Remotes}"
                              SelectedItem="{Binding SelectedRemote, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                            ToolTip="选择获取、拉取和推送使用的远程仓库"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource Action.Push}"
                            Click="Push_OnClick"
                            ToolTip="推送到左侧选中的远程仓库，并打开推送监视窗口"/>
                    <Separator Margin="5,8"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="身份" Click="Identity_OnClick"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="凭据" Click="Credential_OnClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ProgressBar Width="100" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <StackPanel Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentBranch}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveRepositoryPath}" FontSize="10" Opacity="0.58"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" MinWidth="190" MaxWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="400" MinWidth="300" MaxWidth="720"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Section.Repositories}"/>
                        <Button DockPanel.Dock="Right"
                                Content="打开目录"
                                Height="25" MinHeight="25"
                                Padding="8,2" Margin="0,6,8,4"
                                IsEnabled="{Binding HasRepository}"
                                Click="OpenRepositoryFolder_OnClick"
                                ToolTip="在文件资源管理器中打开所选仓库"/>
                        <ComboBox DockPanel.Dock="Right" Width="100" Height="25" Margin="0,6,6,4"
                                  ItemsSource="{Binding RepositorySortModes}"
                                  SelectedItem="{Binding RepositorySortMode, Mode=TwoWay}"
                                  SelectionChanged="RepositorySort_OnSelectionChanged"
                                  ToolTip="仓库排序方式"/>
                    </DockPanel>
                    <ListBox x:Name="RecentRepositoriesList"
                             Grid.Row="1" ItemsSource="{Binding RecentRepositories}"
                             SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                             SelectionChanged="RecentRepositories_OnSelectionChanged"
                             PreviewMouseRightButtonDown="RecentRepositories_OnPreviewMouseRightButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}"
                                               ToolTipService.ShowDuration="60000"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="从列表中移除"
                                          Click="RemoveRepository_OnClick"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}" Text="{DynamicResource Section.Branches}"/>
                    <ListBox x:Name="BranchList" Grid.Row="3" ItemsSource="{Binding Branches}"
                             SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                             MouseDoubleClick="BranchList_OnMouseDoubleClick"
                             PreviewMouseLeftButtonDown="BranchList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="BranchList_OnPreviewMouseRightButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Height="30"
                                           Margin="12,0"
                                           Text="{Binding FriendlyName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="单击查看该分支指向的提交；双击切换分支"
                                           FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeightConverter}, FallbackValue=Normal}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="合并到当前分支" Click="MergeBranch_OnClick"/>
                                <MenuItem Header="重命名该分支…" Click="RenameBranch_OnClick"/>
                                <Separator/>
                                <MenuItem Header="删除该分支…" Click="DeleteBranch_OnClick"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <DockPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Section.Files}"/>
                        <TextBlock Margin="4,0,6,0"
                                   Text="{Binding FileTreeContextText}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.65"/>
                        <Button DockPanel.Dock="Right"
                                Content="返回工作区"
                                Command="{Binding ShowWorkingTreeCommand}"
                                Height="27" MinHeight="27"
                                Padding="8,2" Margin="0,6,8,4"
                                Visibility="{Binding IsBrowsingHistoricalCommit, Converter={StaticResource BoolToVisibility}}"/>
                        <Button x:Name="NewItemButton" DockPanel.Dock="Right"
                                Content="＋ 新建文件" Height="27" MinHeight="27"
                                Padding="8,2" Margin="0,6,8,4"
                                IsEnabled="{Binding CanModifyFileTree}"
                                Click="NewItemMenu_OnClick"
                                ToolTip="在当前选中的目录中新建文件或文件夹">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowsingHistoricalCommit}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="📁  文件夹" Tag="folder"
                                              Click="NewItemType_OnClick"/>
                                    <Separator/>
                                    <MenuItem Header="📄  文本文档 (.txt)" Tag=".txt"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="Ⓜ  Markdown 文档 (.md)" Tag=".md"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="W  Word 文档 (.docx)" Tag=".docx"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="C#  C# 源文件 (.cs)" Tag=".cs"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="◆  JSON 文件 (.json)" Tag=".json"
                                              Click="NewItemType_OnClick"/>
                                    <MenuItem Header="&lt;/&gt;  XML 文件 (.xml)" Tag=".xml"
                                              Click="NewItemType_OnClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="SystemNewTypesMenuItem"
                                              Header="电脑上的其他类型">
                                        <MenuItem Header="正在读取系统新建类型…" IsEnabled="False"/>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>
                    <TreeView x:Name="FileTreeView" Grid.Row="5" ItemsSource="{Binding FileTree}"
                              ItemTemplate="{StaticResource FileTreeTemplate}"
                              SelectedItemChanged="FileTree_OnSelectedItemChanged"
                              MouseDoubleClick="FileTree_OnMouseDoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="新建文件" Click="NewFile_OnClick"
                                          IsEnabled="{Binding CanModifyFileTree}"/>
                                <MenuItem Header="新建文件夹" Click="NewFolder_OnClick"
                                          IsEnabled="{Binding CanModifyFileTree}"/>
                                <MenuItem Header="重命名" Click="RenameFile_OnClick"
                                          IsEnabled="{Binding CanModifyFileTree}"/>
                                <Separator/>
                                <MenuItem Header="删除…" Click="DeleteFile_OnClick"
                                          IsEnabled="{Binding CanModifyFileTree}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="10,4">
                    <TextBlock DockPanel.Dock="Right" Text="点击节点查看详情；右键区域执行历史操作"
                               FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Section.History}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Margin="8,0,0,0" Padding="10,0"
                                Height="26" MinWidth="66"
                                VerticalAlignment="Center"
                                CornerRadius="10" Background="#182D8CFF">
                            <TextBlock Text="{Binding HistoryContextText}"
                                       FontSize="10.5" Foreground="#FF2578C8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ToggleButton IsChecked="{Binding IsCommitGraphCollapsed, Mode=TwoWay}"
                                      Width="30" Height="28"
                                      Margin="6,0,0,0"
                                      Padding="5"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="切换关系图显示">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="收起关系图"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ButtonChrome"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="#12000000"/>
                                                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#28000000"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="#145B8CFF"/>
                                                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#405B8CFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="展开关系图"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Grid Width="18" Height="16" IsHitTestVisible="False">
                                <Border BorderBrush="#FF4B5563" BorderThickness="1.4"
                                        CornerRadius="4"/>
                                <Border Width="4" Height="10" Margin="3,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="#704B5563" CornerRadius="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.25"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Rectangle Width="1" Height="11" Margin="8,0,0,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Fill="#FF4B5563"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <controls:CommitGraphControl Items="{Binding History}"
                                                 Branches="{Binding Branches}"
                                                 Tags="{Binding Tags}"
                                                 Events="{Binding HistoryEvents}"
                                                 Head="{Binding Head}"
                                                 IsGraphCollapsed="{Binding IsCommitGraphCollapsed}"
                                                 SelectedBranchName="{Binding SelectedHistoryBranchName}"
                                                 SelectedCommit="{Binding SelectedCommit, Mode=TwoWay}"
                                                 CommitSelected="CommitGraph_OnCommitSelected"
                                                 BranchSelected="CommitGraph_OnBranchSelected"/>
                </ScrollViewer>
                <Button Grid.Row="2" Content="{DynamicResource Action.LoadMore}"
                        Command="{Binding LoadMoreHistoryCommand}" HorizontalAlignment="Center"/>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragIncrement="2"
                          KeyboardIncrement="16"
                          Cursor="SizeWE"
                          Background="{StaticResource SubtleBorderBrush}"
                          ToolTip="左右拖动可调整详情区域宽度"/>

            <TabControl Grid.Column="4"
                        ClipToBounds="True"
                        SelectedIndex="{Binding SelectedRightTabIndex, Mode=TwoWay}">
                <TabItem Header="{DynamicResource Tab.Diff}">
                    <TabItem.Resources>
                        <DataTemplate x:Key="DiffRegionTemplate">
                            <Border Margin="4" Padding="10"
                                    MinWidth="540"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Text="{Binding LocationText}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Blocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,7" Padding="8"
                                                        Background="{StaticResource PanelBrush}"
                                                        CornerRadius="5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,2,0,6" Text="{Binding Description}"
                                                                   FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"/>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="260"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="260"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DataContext.OldLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       FontSize="10.5" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DataContext.NewLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="260"/>
                                                                            <ColumnDefinition Width="8"/>
                                                                            <ColumnDefinition Width="260"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Padding="6,4" CornerRadius="3">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#14D84A4A"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsContext}" Value="True">
                                                                                            <Setter Property="Background" Value="#0E6B7280"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasOldLine}" Value="False">
                                                                                            <Setter Property="Background" Value="#0E6B7280"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding OldLineLabel}"
                                                                                           FontSize="9.5" Opacity="0.55"/>
                                                                                <TextBlock Text="{Binding OldDisplayText}"
                                                                                           FontFamily="Cascadia Mono,Consolas"
                                                                                           FontSize="11" TextWrapping="NoWrap"/>
                                                                                <TextBlock Text="{Binding OldAnnotation}"
                                                                                           FontSize="9.5" Foreground="#FFC47A00"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="2" Padding="6,4" CornerRadius="3">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#1428A745"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsContext}" Value="True">
                                                                                            <Setter Property="Background" Value="#0E6B7280"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasNewLine}" Value="False">
                                                                                            <Setter Property="Background" Value="#0E6B7280"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding NewLineLabel}"
                                                                                           FontSize="9.5" Opacity="0.55"/>
                                                                                <TextBlock Text="{Binding NewDisplayText}"
                                                                                           FontFamily="Cascadia Mono,Consolas"
                                                                                           FontSize="11" TextWrapping="NoWrap"/>
                                                                                <TextBlock Text="{Binding NewAnnotation}"
                                                                                           FontSize="9.5" Foreground="#FFC47A00"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </TabItem.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="7">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding RawDiffToggleText}" Padding="12,4"
                                        Click="ToggleRawDiff_OnClick"
                                        Visibility="{Binding CanShowRawDiff, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="暂存所选块" Padding="12,4" Click="StageSelectedHunks_OnClick">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasDiffHunks}" Value="True"/>
                                                        <Condition Binding="{Binding SelectedChange.IsStaged}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="取消暂存所选块" Padding="12,4" Click="UnstageSelectedHunks_OnClick">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasDiffHunks}" Value="True"/>
                                                        <Condition Binding="{Binding SelectedChange.IsStaged}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding DiffContextText}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Grid.Row="1" Margin="7,0,7,5" Padding="8,6"
                                Background="{StaticResource PanelBrush}" CornerRadius="5">
                            <TextBlock Text="{Binding DiffSummaryText}" TextWrapping="Wrap"/>
                        </Border>
                        <Grid Grid.Row="2" ClipToBounds="True">
                            <Grid x:Name="WorkingDiffCards">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowWorkingDiffCards}" Value="True"/>
                                                    <Condition Binding="{Binding ShowRawDiff}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Margin="7,2,7,4" Padding="9"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        DataContext="{Binding SelectedDiffFile}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                       FontSize="10.5" Opacity="0.62"/>
                                            <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Summary}"
                                                   FontSize="10.5" TextWrapping="Wrap"/>
                                        <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding Notices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="10.5"
                                                               Foreground="#FFC47A00" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="HunkList" Grid.Row="1" ItemsSource="{Binding DiffRegions}"
                                         ItemTemplate="{StaticResource DiffRegionTemplate}"
                                         SelectionMode="Extended" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowCommitDiffCards}" Value="True"/>
                                                    <Condition Binding="{Binding ShowRawDiff}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl Margin="5" ItemsSource="{Binding DiffFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="2,2,2,7" IsExpanded="False">
                                                <Expander.Header>
                                                    <Border MinWidth="520" Padding="9">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                                           FontSize="10.5" Opacity="0.62"/>
                                                                <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold"/>
                                                            </DockPanel>
                                                            <TextBlock Margin="0,3,0,0" Text="{Binding Summary}"
                                                                       FontSize="10.5" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <StackPanel>
                                                    <ItemsControl Margin="8,0" ItemsSource="{Binding Notices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="10.5"
                                                                           Foreground="#FFC47A00" TextWrapping="Wrap"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Regions}"
                                                                  ItemTemplate="{StaticResource DiffRegionTemplate}"/>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBox Text="{Binding DiffRawText}" FontFamily="Cascadia Mono,Consolas"
                                     FontSize="12" IsReadOnly="True" AcceptsReturn="True"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowRawDiff}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Tab.Editor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="5">
                            <Button DockPanel.Dock="Right" Content="保存并暂存"
                                    Command="{Binding SaveAndStageEditorCommand}"
                                    Visibility="{Binding CanSaveCurrentDocument, Converter={StaticResource BoolToVisibility}}"/>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Action.Save}"
                                    Command="{Binding SaveEditorCommand}"
                                    Visibility="{Binding CanSaveCurrentDocument, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock DockPanel.Dock="Right" Margin="8,0"
                                       Text="未保存" Foreground="#E08A1E"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasUnsavedEditorChanges, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding CurrentDocument.Path}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentDocument.Path}"/>
                        </DockPanel>
                        <avalon:TextEditor Grid.Row="1"
                                           controls:AvalonEditBinding.Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           FontFamily="Cascadia Mono,Consolas" FontSize="13"
                                           ShowLineNumbers="True" WordWrap="False">
                            <avalon:TextEditor.Style>
                                <Style TargetType="{x:Type avalon:TextEditor}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalOnlyDocument}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </avalon:TextEditor.Style>
                        </avalon:TextEditor>
                        <Border Grid.Row="1" Margin="18" Padding="24"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsExternalOnlyDocument, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="440">
                                <TextBlock Text="此文件需要使用外部程序打开"
                                           FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,10,0,18"
                                           Text="{Binding ExternalDocumentHint}"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Opacity="0.7"/>
                                <Button Content="使用默认程序打开"
                                        Command="{Binding OpenCurrentDocumentExternallyCommand}"
                                        Visibility="{Binding CanOpenCurrentDocumentExternally, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center"
                                        Padding="18,6"/>
                                <TextBlock Margin="0,12,0,0"
                                           Text="提示：在左侧文件树中双击也可以直接打开。"
                                           FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource Tab.Details}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding DetailsText}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <Border.Resources>
                                <Style x:Key="CommitActionButton" TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="MinHeight" Value="48"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </Border.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="5,1,5,5">
                                    <TextBlock DockPanel.Dock="Right" Text="先选择提交，再选择操作"
                                               FontSize="10.5" Opacity="0.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="所选提交操作" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <UniformGrid Grid.Row="1" Columns="3" Rows="2">
                                    <Button Style="{StaticResource CommitActionButton}"
                                            Click="CreateBranch_OnClick"
                                            ToolTip="从所选提交创建一个新的本地分支">
                                        <StackPanel>
                                            <TextBlock Text="创建分支" HorizontalAlignment="Center"/>
                                            <TextBlock Text="保留此版本" FontSize="10" Opacity="0.55"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CommitActionButton}"
                                            Click="CompareCommits_OnClick"
                                            Background="{StaticResource AccentBrush}" Foreground="White"
                                            ToolTip="选择另一个提交并查看文件差异">
                                        <StackPanel>
                                            <TextBlock Text="比较提交" HorizontalAlignment="Center"/>
                                            <TextBlock Text="查看文件差异" FontSize="10" Opacity="0.75"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CommitActionButton}"
                                            Click="CheckoutCommit_OnClick"
                                            ToolTip="切换到所选提交并进入游离 HEAD">
                                        <StackPanel>
                                            <TextBlock Text="切换提交" HorizontalAlignment="Center"/>
                                            <TextBlock Text="进入游离 HEAD" FontSize="10" Opacity="0.55"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CommitActionButton}"
                                            Click="CherryPick_OnClick"
                                            ToolTip="把所选提交应用到当前分支">
                                        <StackPanel>
                                            <TextBlock Text="拣选提交" HorizontalAlignment="Center"/>
                                            <TextBlock Text="应用到当前分支" FontSize="10" Opacity="0.55"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CommitActionButton}"
                                            Click="Revert_OnClick"
                                            ToolTip="创建新提交来撤销所选提交">
                                        <StackPanel>
                                            <TextBlock Text="撤销提交" HorizontalAlignment="Center"/>
                                            <TextBlock Text="生成反向提交" FontSize="10" Opacity="0.55"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CommitActionButton}"
                                            Click="Reset_OnClick"
                                            Foreground="{StaticResource DangerBrush}"
                                            ToolTip="将当前分支回退到所选提交">
                                        <StackPanel>
                                            <TextBlock Text="回退分支…" HorizontalAlignment="Center"/>
                                            <TextBlock Text="移动当前分支" FontSize="10" Opacity="0.65"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="冲突">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="10" MinHeight="500">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="84"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Padding="12,9"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        Padding="9,3"
                                        CornerRadius="10"
                                        Background="#185B8CFF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Conflicts.Count, StringFormat={}{0} 个待处理}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="冲突解决器"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ConflictStatusText}"
                                               Margin="0,3,12,0"
                                               FontSize="11"
                                               Opacity="0.62"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,8,0,8"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <ListBox x:Name="ConflictList"
                                         ItemsSource="{Binding Conflicts}"
                                         SelectedItem="{Binding SelectedConflict, Mode=TwoWay}"
                                         BorderThickness="0"
                                         SelectionChanged="ConflictList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2">
                                                <Border x:Name="BinaryBadge"
                                                        DockPanel.Dock="Right"
                                                        Padding="6,2"
                                                        CornerRadius="8"
                                                        Background="#18E05D5D"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="二进制"
                                                               FontSize="10"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Path}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBinary}" Value="True">
                                                    <Setter TargetName="BinaryBadge" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="没有待处理的冲突文件"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.5"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Conflicts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid IsEnabled="{Binding HasSelectedConflict}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="2*" MinHeight="70"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="3*" MinHeight="90"/>
                                </Grid.RowDefinitions>

                                <Border Padding="9,6"
                                        Background="{StaticResource PanelBrush}"
                                        CornerRadius="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   FontSize="10"
                                                   Opacity="0.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="选择版本后仍可在下方手工编辑"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedConflict.IsBinary}" Value="True">
                                                            <Setter Property="Text" Value="二进制文件：文本解决已安全锁定"/>
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedConflict.Path, TargetNullValue=未选择文件}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedConflict.Path}"/>
                                    </DockPanel>
                                </Border>

                                <Expander Grid.Row="1"
                                          Header="查看共同祖先版本（Base）"
                                          Margin="0,5,0,5"
                                          FontSize="11">
                                    <TextBox Text="{Binding ConflictBaseText}"
                                             MaxHeight="120"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Expander>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Padding="9,0"
                                                    Background="#125B8CFF"
                                                    CornerRadius="4,4,0,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right"
                                                            Padding="6,2"
                                                            CornerRadius="8"
                                                            Background="#205B8CFF"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="OURS"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="当前版本"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding ConflictOursText}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     AcceptsTab="True"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     BorderThickness="0"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1"
                                                  Width="6"
                                                  HorizontalAlignment="Stretch"
                                                  Background="Transparent"/>

                                    <Border Grid.Column="2"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Padding="9,0"
                                                    Background="#12F5A623"
                                                    CornerRadius="4,4,0,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right"
                                                            Padding="6,2"
                                                            CornerRadius="8"
                                                            Background="#20F5A623"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="THEIRS"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource WarningBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="对方版本"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding ConflictTheirsText}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     AcceptsTab="True"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     BorderThickness="0"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <GridSplitter Grid.Row="3"
                                              Height="5"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="Transparent"/>

                                <Border Grid.Row="4"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Padding="9,0"
                                                Background="#125B8CFF"
                                                CornerRadius="4,4,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="可编辑"
                                                           FontSize="10"
                                                           Opacity="0.55"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="合并结果"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="5,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="采用当前"
                                                    Padding="5,3"
                                                    MinHeight="28"
                                                    IsEnabled="{Binding CanEditSelectedConflict}"
                                                    Click="UseOurs_OnClick"/>
                                            <Button Grid.Column="1"
                                                    Content="采用对方"
                                                    Padding="5,3"
                                                    MinHeight="28"
                                                    IsEnabled="{Binding CanEditSelectedConflict}"
                                                    Click="UseTheirs_OnClick"/>
                                            <Button Grid.Column="2"
                                                    Content="合并两者"
                                                    Padding="5,3"
                                                    MinHeight="28"
                                                    IsEnabled="{Binding CanEditSelectedConflict}"
                                                    Click="UseBoth_OnClick"/>
                                        </Grid>
                                        <TextBox Grid.Row="2"
                                                 Text="{Binding ConflictResultText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding SelectedConflict.IsBinary}"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 BorderThickness="0"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="确认内容正确后，在下方标记为已解决"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.RowSpan="4"
                                        Panel.ZIndex="10"
                                        Padding="24"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedConflict.IsBinary}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                                        <TextBlock Text="二进制冲突安全解决器"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Margin="0,10,0,18"
                                                   Text="程序会直接复制 Git 对象中的原始字节，不会把文件当作文本解码。也可以先用外部程序替换工作区文件，再采用当前工作区文件。"
                                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65"/>
                                        <UniformGrid Columns="3">
                                            <Button Content="采用当前版本 (ours)" Margin="3" Padding="10,8"
                                                    Click="ResolveBinaryOurs_OnClick"/>
                                            <Button Content="采用对方版本 (theirs)" Margin="3" Padding="10,8"
                                                    Click="ResolveBinaryTheirs_OnClick"/>
                                            <Button Content="使用当前工作区文件" Margin="3" Padding="10,8"
                                                    Click="ResolveBinaryCurrentFile_OnClick"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Padding="24"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedConflict}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✓"
                                               HorizontalAlignment="Center"
                                               FontSize="28"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text="没有需要编辑的冲突"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="出现冲突时，请先从上方选择一个文件。"
                                               Margin="0,4,0,0"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               Opacity="0.55"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,9,0,0"
                                Padding="8"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="完成当前文件"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="保存合并结果并加入暂存区"
                                                   Margin="0,2,12,0"
                                                   FontSize="10"
                                                   Opacity="0.55"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="标记为已解决"
                                            Padding="13,5"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            IsEnabled="{Binding CanEditSelectedConflict}"
                                            Click="ResolveConflict_OnClick"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="继续 Git 操作"
                                            IsEnabled="{Binding CanContinueOperation}"
                                            ToolTip="所有冲突解决后继续合并、变基或拣选操作"
                                            Click="ContinueOperation_OnClick"/>
                                    <Button Grid.Column="1"
                                            Content="中止 Git 操作"
                                            Foreground="{StaticResource DangerBrush}"
                                            IsEnabled="{Binding CanAbortOperation}"
                                            ToolTip="放弃当前操作并恢复到操作前状态"
                                            Click="AbortOperation_OnClick"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Tab.Log}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding OperationLog}"
                                 SelectedItem="{Binding SelectedOperationLog, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                       Opacity="0.55" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding EquivalentCommand}" FontFamily="Consolas"
                                                   FontSize="10" Opacity="0.6"/>
                                        <TextBlock Text="{Binding DetailsText}"
                                                   FontSize="10"
                                                   Foreground="#C62828"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="8">
                            <TextBlock Text="{DynamicResource Hint.EquivalentCommand}" FontSize="10" Opacity="0.55"/>
                            <TextBox Text="{Binding EquivalentCommand}" IsReadOnly="True" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      Background="{StaticResource SubtleBorderBrush}"
                      ToolTip="上下拖动可调整暂存功能区高度"/>

        <Border Grid.Row="4" BorderBrush="{StaticResource SectionDividerBrush}"
                BorderThickness="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource SectionDividerBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SectionHeaderBrush}"
                                BorderBrush="{StaticResource SectionDividerBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="丢弃所选…"
                                            Click="DiscardChange_OnClick"
                                            Margin="4,0,0,0" VerticalAlignment="Center"
                                            ToolTip="恢复所选文件到暂存区版本；未跟踪文件会被删除，操作前会创建恢复点"/>
                                    <Button Content="暂存所选"
                                            Click="StageSelectedFiles_OnClick"
                                            Margin="4,0,0,0" VerticalAlignment="Center"
                                            ToolTip="仅暂存当前选中的文件；若相关编辑器内容未保存，将先保存"/>
                                    <CheckBox x:Name="SelectAllUnstagedCheckBox"
                                              Width="18" Height="18" Margin="8,0,2,0"
                                              VerticalAlignment="Center"
                                              Click="SelectAllUnstaged_OnClick"
                                              ToolTip="选择或取消选择全部未暂存文件"
                                              AutomationProperties.Name="选择全部未暂存文件"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Section.Unstaged}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <ListBox x:Name="UnstagedList"
                                     Margin="4,4,4,6" BorderThickness="0"
                                     ItemsSource="{Binding UnstagedChanges}"
                                     ItemTemplate="{StaticResource ChangeTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="ChangeList_OnSelectionChanged"
                                     PreviewMouseLeftButtonDown="ChangeList_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseRightButtonDown="ChangeList_OnPreviewMouseRightButtonDown"
                                     PreviewMouseRightButtonUp="ChangeList_OnPreviewMouseRightButtonUp"
                                     PreviewMouseMove="ChangeList_OnPreviewMouseMove"
                                     AllowDrop="True" Drop="UnstagedList_OnDrop">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="丢弃所选文件的未暂存修改…" Click="DiscardChange_OnClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <Canvas x:Name="UnstagedSelectionOverlay" IsHitTestVisible="False" ClipToBounds="True">
                                <Rectangle x:Name="UnstagedSelectionRectangle"
                                           Visibility="Collapsed"
                                           Fill="#285B8CFF" Stroke="{StaticResource AccentBrush}"
                                           StrokeThickness="1" StrokeDashArray="3,2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" BorderBrush="{StaticResource SectionDividerBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SectionHeaderBrush}"
                                BorderBrush="{StaticResource SectionDividerBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="取消所选"
                                            Click="UnstageSelectedFiles_OnClick"
                                            Margin="4,0,0,0" VerticalAlignment="Center"
                                            ToolTip="仅取消暂存当前选中的文件"/>
                                    <CheckBox x:Name="SelectAllStagedCheckBox"
                                              Width="18" Height="18" Margin="8,0,2,0"
                                              VerticalAlignment="Center"
                                              Click="SelectAllStaged_OnClick"
                                              ToolTip="选择或取消选择全部已暂存文件"
                                              AutomationProperties.Name="选择全部已暂存文件"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Section.Staged}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <ListBox x:Name="StagedList"
                                     Margin="4,4,4,6" BorderThickness="0"
                                     ItemsSource="{Binding StagedChanges}"
                                     ItemTemplate="{StaticResource ChangeTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="ChangeList_OnSelectionChanged"
                                     PreviewMouseLeftButtonDown="ChangeList_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseRightButtonDown="ChangeList_OnPreviewMouseRightButtonDown"
                                     PreviewMouseRightButtonUp="ChangeList_OnPreviewMouseRightButtonUp"
                                     PreviewMouseMove="ChangeList_OnPreviewMouseMove"
                                     AllowDrop="True" Drop="StagedList_OnDrop"/>
                            <Canvas x:Name="StagedSelectionOverlay" IsHitTestVisible="False" ClipToBounds="True">
                                <Rectangle x:Name="StagedSelectionRectangle"
                                           Visibility="Collapsed"
                                           Fill="#285B8CFF" Stroke="{StaticResource AccentBrush}"
                                           StrokeThickness="1" StrokeDashArray="3,2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="CommitPanel" Grid.Column="2"
                      SizeChanged="CommitPanel_OnSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition x:Name="CommitMessageRow" Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource SectionHeaderBrush}"
                            BorderBrush="{StaticResource SectionDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,4">
                            <TextBlock x:Name="CommitMessageHint"
                                       DockPanel.Dock="Right" Text="填写说明后提交"
                                       FontSize="10.5" Opacity="0.5" VerticalAlignment="Center"/>
                            <TextBlock Text="提交" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="CommitMessageTextBox"
                             Grid.Row="1" Margin="10,8,10,4"
                             Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="{DynamicResource Hint.CommitMessage}"/>
                    <StackPanel Grid.Row="2" Margin="7,0,7,6"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="修订最新提交"
                                Command="{Binding AmendCommand}"
                                ToolTip="用当前提交说明和已暂存内容替换当前分支的最新提交"/>
                        <Button Content="{DynamicResource Action.Commit}" Command="{Binding CommitCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <ItemsControl ItemsSource="{Binding Notices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" Margin="6,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="CloneOverlay"
              Grid.RowSpan="6"
              Panel.ZIndex="1000"
              Background="#66000000"
              Visibility="{Binding IsCloning, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560"
                    MaxWidth="560"
                    Padding="30,26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="5"
                                      Opacity="0.38"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Ellipse Width="11" Height="11"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever"
                                                    AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.2"
                                                             Duration="0:0:0.45"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="CloneTitleText"
                                   Text="正在克隆远程仓库"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,18"
                               Text="正在下载提交、分支和文件，请稍候…"
                               FontSize="13"
                               Opacity="0.68"
                               HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="CloneProgressBar"
                                 Height="9"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Margin="0,16,0,0"
                               Text="克隆到"
                               FontSize="11"
                               Opacity="0.58"/>
                    <TextBlock x:Name="CloneDestinationText"
                               Margin="0,5,0,0"
                               Text="{Binding CloneDestinationPath}"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               ToolTip="{Binding CloneDestinationPath}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="PullOverlay"
              Grid.RowSpan="6"
              Panel.ZIndex="1000"
              Background="#66000000"
              Visibility="{Binding IsPulling, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560"
                    MaxWidth="560"
                    Padding="30,26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="5"
                                      Opacity="0.38"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Ellipse Width="11" Height="11"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever"
                                                    AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.2"
                                                             Duration="0:0:0.45"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="正在拉取远程更新"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,18"
                               Text="正在获取远程提交并更新当前分支，请稍候…"
                               FontSize="13"
                               Opacity="0.68"
                               HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="PullProgressBar"
                                 Height="9"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Margin="0,16,0,0"
                               Text="更新方向"
                               FontSize="11"
                               Opacity="0.58"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PullSourceText"
                               Margin="0,5,0,0"
                               Text="{Binding PullSourceText}"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               ToolTip="{Binding PullSourceText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
