<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GitVisualizer.App.Dialogs.CommitComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="比较提交" Width="680" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" xmlns:dialogs="clr-namespace:GitVisualizer.App.Dialogs;assembly=GitVisualizer">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="比较两个提交" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,5,0,0" Text="差异方向为旧提交 → 新提交；结果会显示在主窗口的“差异”页。" Opacity="0.62" />
    </StackPanel>
    <Grid Row="1" Margin="0,18,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="旧提交（基准）" VerticalAlignment="Center" />
      <ComboBox Name="OldCommitBox" Grid.Column="1" MinWidth="480" ItemsSource="{Binding}" TextSearch.TextPath="DisplayText">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Cascadia Mono,Consolas" Foreground="{DynamicResource AccentBrush}" Text="{Binding ShortId}" />
              <TextBlock Margin="8,0,0,0" MaxWidth="430" TextTrimming="CharacterEllipsis" Text="{Binding Message}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="新提交（目标）" VerticalAlignment="Center" />
      <ComboBox Name="NewCommitBox" Grid.Column="1" MinWidth="480" ItemsSource="{Binding}" TextSearch.TextPath="DisplayText">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Cascadia Mono,Consolas" Foreground="{DynamicResource AccentBrush}" Text="{Binding ShortId}" />
              <TextBlock Margin="8,0,0,0" MaxWidth="430" TextTrimming="CharacterEllipsis" Text="{Binding Message}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
    </Grid>
    <DockPanel Grid.Row="3">
      <Button DockPanel.Dock="Left" Content="交换方向" Padding="16,5" Click="Swap_OnClick" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="取消" IsCancel="True" Padding="18,5" />
        <Button Content="比较" IsDefault="True" Padding="18,5" Click="Compare_OnClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
