<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GitVisualizer.App.Dialogs.StashManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="临时现场（stash）" Width="690" Height="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:dialogs="clr-namespace:GitVisualizer.App.Dialogs;assembly=GitVisualizer">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="临时现场（stash）" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,5,0,0" Text="保存会包含未跟踪文件；弹出或删除前会创建隐藏安全引用。" Opacity="0.62" />
    </StackPanel>
    <Grid Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Name="MessageBox" ToolTip="临时现场说明（可留空）" />
      <Button Grid.Column="1" Content="保存当前现场" Margin="10,0,0,0" Padding="16,5" Click="Save_OnClick" />
    </Grid>
    <ListBox Name="StashList" Grid.Row="2" ItemsSource="{Binding}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4">
            <TextBlock FontWeight="SemiBold">
              <Run Text="stash@{" />
              <Run Text="{Binding Index}" />
              <Run Text="}  " />
              <Run Text="{Binding Message}" />
            </TextBlock>
            <TextBlock FontSize="11" Opacity="0.55" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Padding="18,5" />
      <StackPanel Orientation="Horizontal">
        <Button Content="应用（保留）" Padding="14,5" Click="Apply_OnClick" />
        <Button Content="弹出（应用并移除）" Margin="8,0,0,0" Padding="14,5" Click="Pop_OnClick" />
        <Button Content="删除" Margin="8,0,0,0" Padding="14,5" Foreground="#FFE05D5D" Click="Delete_OnClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>